info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (172ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.can_have_children, d.can_have_value, d.can_repeat, d.configuration_schema_json, d.created_at, d.created_by, d.name, d.parent_type_id, d.rbacobject_id, d.renderer_key, d.updated_at, d.updated_by
      FROM dp_form_node_types AS d
      WHERE d.rbacobject_id IN (
          SELECT e.rbacobject_id
          FROM effective_access AS e
          INNER JOIN role_type_operations AS r ON e.role_type_id = r.role_type_id
          WHERE e.user_id = @userId AND e.valid_from_unix_ms &lt;= @nowUnixMs AND (e.valid_to_unix_ms IS NULL OR e.valid_to_unix_ms &gt;= @nowUnixMs2) AND r.operation_id = @operationId
