      Executed DbCommand (4ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.created_at, d.created_by, d.form_definition_id, d.is_published, d.published_at, d.rbacobject_id, d.updated_at, d.updated_by, d.version
      FROM dp_form_versions AS d
      WHERE d.rbacobject_id IN (
          SELECT e.rbacobject_id
          FROM effective_access AS e
          INNER JOIN role_type_operations AS r ON e.role_type_id = r.role_type_id
          WHERE e.user_id = @userId AND e.valid_from_unix_ms &lt;= @nowUnixMs AND (e.valid_to_unix_ms IS NULL OR e.valid_to_unix_ms &gt;= @nowUnixMs2) AND r.operation_id = @operationId
      ) AND d.id = @id
      LIMIT 2
