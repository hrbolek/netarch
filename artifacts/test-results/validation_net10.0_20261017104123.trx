      SELECT r.id, r.created_at, r.created_by, r.name, r.rbacobject_id, r.updated_at, r.updated_by
      FROM role_types AS r
      WHERE r.rbacobject_id IN (
          SELECT e.rbacobject_id
          FROM effective_access AS e
          INNER JOIN role_type_operations AS r0 ON e.role_type_id = r0.role_type_id
          WHERE e.user_id = @userId AND e.valid_from_unix_ms &lt;= @nowUnixMs AND (e.valid_to_unix_ms IS NULL OR e.valid_to_unix_ms &gt;= @nowUnixMs2) AND r0.operation_id = @operationId
      ) AND r.id = @id
      LIMIT 2
