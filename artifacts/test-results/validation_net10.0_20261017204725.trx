      Executed DbCommand (17ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @formVersionId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.form_version_id, d.parent_id, d.path, d.key, d.label, d.description, d.node_type_id, d.position, d.min_occurs, d.max_occurs, d.own_security_scope, d.configuration_json, d.rbacobject_id, d.created_at, d.updated_at, d.created_by, d.updated_by, COALESCE(d.label, d.key)
      FROM dp_form_nodes AS d
      WHERE d.rbacobject_id IN (
          SELECT e.rbacobject_id
          FROM effective_access AS e
          INNER JOIN role_type_operations AS r ON e.role_type_id = r.role_type_id
          WHERE e.user_id = @userId AND e.valid_from_unix_ms &lt;= @nowUnixMs AND (e.valid_to_unix_ms IS NULL OR e.valid_to_unix_ms &gt;= @nowUnixMs2) AND r.operation_id = @operationId
      ) AND d.form_version_id = @formVersionId
      ORDER BY d.path, d.position
info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (5ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.parent_type_id, d.name, d.renderer_key, d.can_have_children, d.can_have_value, d.can_repeat, d.configuration_schema_json, d.rbacobject_id, d.created_at, d.updated_at, d.created_by, d.updated_by
      FROM dp_form_node_types AS d
      WHERE d.rbacobject_id IN (
          SELECT e.rbacobject_id
          FROM effective_access AS e
          INNER JOIN role_type_operations AS r ON e.role_type_id = r.role_type_id
