      Executed DbCommand (17ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.created_at, d.created_by, d.form_definition_id, d.is_published, d.published_at, d.rbacobject_id, d.updated_at, d.updated_by, d.version
