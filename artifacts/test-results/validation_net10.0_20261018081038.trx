        created_by uuid NOT NULL, updated_by uuid NOT NULL,
        "ParentId" uuid NULL, "Code" text NOT NULL, "Name" text NOT NULL,
        "Description" text NULL, "Abbreviation" text NULL, "Color" text NULL,
