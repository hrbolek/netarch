      SELECT d.id, d.created_at, d.created_by, d.is_published, d.published_at, d.rbacobject_id, d.updated_at, d.updated_by, d.version, d.workflow_definition_id
      FROM dp_workflow_versions AS d
      WHERE d.rbacobject_id IN (
