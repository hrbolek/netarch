        UNION ALL SELECT c.id, t.p || c.id::text || '/' FROM event_types c JOIN t ON c."ParentId" = t.id)
      UPDATE event_types e SET path = t.p FROM t WHERE e.id = t.id AND e.path = '';
      WITH RECURSIVE t AS (
