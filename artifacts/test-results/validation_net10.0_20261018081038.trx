      Executed DbCommand (18ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT r.id, r.created_at, r.created_by, r.name, r.rbacobject_id, r.updated_at, r.updated_by
      FROM role_types AS r
      WHERE r.rbacobject_id IN (
