      CREATE UNIQUE INDEX IF NOT EXISTS "IX_event_participants_EventId_GroupId" ON event_participants("EventId", "GroupId");
      CREATE INDEX IF NOT EXISTS "IX_event_participants_SourceId" ON event_participants("SourceId");
