      CREATE UNIQUE INDEX IF NOT EXISTS "IX_event_types_Code" ON event_types("Code");
      CREATE INDEX IF NOT EXISTS "IX_event_types_ParentId" ON event_types("ParentId");
      CREATE TABLE IF NOT EXISTS events (
