      );
      CREATE UNIQUE INDEX IF NOT EXISTS "IX_event_participant_roles_Code" ON event_participant_roles("Code");
      CREATE TABLE IF NOT EXISTS event_participants (
        id uuid PRIMARY KEY, rbacobject_id uuid NOT NULL,
