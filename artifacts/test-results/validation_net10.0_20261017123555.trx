      SELECT d.id, d.form_version_id, d.parent_id, d.path, d.key, d.label, d.description, d.node_type_id, d.position, d.min_occurs, d.max_occurs, d.own_security_scope, d.configuration_json, d.rbacobject_id, d.created_at, d.updated_at, d.created_by, d.updated_by, COALESCE(d.label, d.key)
