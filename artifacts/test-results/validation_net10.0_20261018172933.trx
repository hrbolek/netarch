        "RespondedAt" timestamp with time zone NULL,
        "StatusChangedAt" timestamp with time zone NULL,
        CONSTRAINT ck_event_participant_target CHECK (
            ("UserId" IS NOT NULL AND "GroupId" IS NULL)
