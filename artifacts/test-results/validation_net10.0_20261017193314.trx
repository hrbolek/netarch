      Executed DbCommand (4ms) [Parameters=[@userId='?' (DbType = Guid), @rbacId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs3='?' (DbType = Int64)], CommandType='Text', CommandTimeout='30']
      SELECT o.name
      FROM operations AS o
      WHERE o.id IN (
          SELECT r.operation_id
          FROM role_type_operations AS r
          WHERE r.role_type_id IN (
              SELECT e.role_type_id
              FROM effective_access AS e
              WHERE e.user_id = @userId AND e.rbacobject_id = @rbacId AND e.valid_from_unix_ms &lt;= @nowUnixMs AND (e.valid_to_unix_ms IS NULL OR e.valid_to_unix_ms &gt;= @nowUnixMs3)
          )
      )
