        CONSTRAINT "FK_event_types_event_types_ParentId" FOREIGN KEY ("ParentId") REFERENCES event_types(id) ON DELETE RESTRICT
      );
      CREATE UNIQUE INDEX IF NOT EXISTS "IX_event_types_Code" ON event_types("Code");
