        "FacilityId" uuid NOT NULL REFERENCES facilities(id) ON DELETE RESTRICT,
        "EventId" uuid NOT NULL REFERENCES events(id) ON DELETE RESTRICT,
        "StartsAt" timestamptz NOT NULL, "EndsAt" timestamptz NOT NULL,
