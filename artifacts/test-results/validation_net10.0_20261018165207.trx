        CONSTRAINT "FK_events_events_ParentId" FOREIGN KEY ("ParentId") REFERENCES events(id) ON DELETE RESTRICT
      );
      CREATE INDEX IF NOT EXISTS "IX_events_EventTypeId" ON events("EventTypeId");
