      ALTER TABLE facilities ALTER COLUMN "Code" SET NOT NULL;
      DO $$
      BEGIN
        IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conrelid = 'facilities'::regclass AND conname = 'ck_facility_code') THEN
