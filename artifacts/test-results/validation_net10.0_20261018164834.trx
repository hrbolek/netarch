      DO $$
      BEGIN
        IF EXISTS (SELECT 1 FROM operations WHERE id = 'e326f9a1-68bb-4fb8-8d49-45fb36cd55c5'::uuid AND lower(name) &lt;&gt; 'move') THEN
          RAISE EXCEPTION 'Facilities move operation ID is already assigned to another operation';
