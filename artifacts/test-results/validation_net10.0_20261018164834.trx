info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (25ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT u.id, u.name, u.email, u.surname, u.rbacobject_id, u.created_at, u.updated_at, u.created_by, u.updated_by, CASE
          WHEN btrim(u.name || ' ' || COALESCE(u.surname, ''), E' \t\n\r') &lt;&gt; '' THEN btrim(u.name || ' ' || COALESCE(u.surname, ''), E' \t\n\r')
          ELSE COALESCE(u.email, 'User')
      END
      FROM users AS u
      WHERE u.rbacobject_id IN (
          SELECT e.rbacobject_id
