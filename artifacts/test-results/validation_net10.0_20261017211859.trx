        id uuid PRIMARY KEY, rbacobject_id uuid NOT NULL,
        created_at timestamp with time zone NOT NULL, updated_at timestamp with time zone NOT NULL,
        created_by uuid NOT NULL, updated_by uuid NOT NULL,
