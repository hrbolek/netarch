      SELECT d.id, d.parent_type_id, d.name, d.renderer_key, d.can_have_children, d.can_have_value, d.can_repeat, d.configuration_schema_json, d.rbacobject_id, d.created_at, d.updated_at, d.created_by, d.updated_by
