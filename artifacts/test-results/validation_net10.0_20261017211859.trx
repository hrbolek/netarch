info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (1,119ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.configuration_json, d.created_at, d.created_by, d.description, d.form_version_id, d.key, d.label, d.max_occurs, d.min_occurs, d.node_type_id, d.own_security_scope, d.parent_id, d.path, d.position, d.rbacobject_id, d.updated_at, d.updated_by
      FROM dp_form_nodes AS d
      WHERE d.rbacobject_id IN (
          SELECT e.rbacobject_id
          FROM effective_access AS e
          INNER JOIN role_type_operations AS r ON e.role_type_id = r.role_type_id
          WHERE e.user_id = @userId AND e.valid_from_unix_ms &lt;= @nowUnixMs AND (e.valid_to_unix_ms IS NULL OR e.valid_to_unix_ms &gt;= @nowUnixMs2) AND r.operation_id = @operationId
      ) AND d.id = @id
      LIMIT 2
