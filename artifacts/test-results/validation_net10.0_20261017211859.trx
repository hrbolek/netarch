      Executed DbCommand (8ms) [Parameters=[@userId='?' (DbType = Guid), @nowUnixMs='?' (DbType = Int64), @nowUnixMs2='?' (DbType = Int64), @operationId='?' (DbType = Guid), @id='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']
      SELECT d.id, d.configuration_json, d.created_at, d.created_by, d.description, d.form_version_id, d.key, d.label, d.max_occurs, d.min_occurs, d.node_type_id, d.own_security_scope, d.parent_id, d.path, d.position, d.rbacobject_id, d.updated_at, d.updated_by
      FROM dp_form_nodes AS d
