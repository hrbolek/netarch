@using RootNamespace.EntityName.Models
@using WebAppArchitecture.Base.UI.Components

@namespace RootNamespace.EntityName.UI.Components

<EditableCard TModel="EntityNameResponse" Model="@Model" HeaderText="EntityTitle">
    <ChildContent Context="item">
        <form>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" name="Name" value="@item.Name" />
            </div>
        </form>
    </ChildContent>
</EditableCard>

@code {
    [Parameter, EditorRequired]
    public EntityNameResponse Model { get; set; } = default!;
}
