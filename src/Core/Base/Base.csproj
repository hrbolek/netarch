<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebAppArchitecture.Base</RootNamespace>
    <RazorLangVersion>8.0</RazorLangVersion>
  </PropertyGroup>

  <!-- Compatibility guard: Update 10 placed BaseService.cs in this project.
       When a newer ZIP is unpacked over an older workspace the stale file can
       remain and would otherwise be picked up by the SDK default Compile glob. -->
  <ItemGroup>
    <Compile Remove="Services/BaseService.cs" />
    <Compile Remove="Security/SecurityService.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Swashbuckle.AspNetCore" />

    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!-- Refactoring compatibility: exclude source files superseded by per-type files.
       SDK default glob otherwise compiles stale sources when ZIPs are overlaid. -->
  <ItemGroup>
    <Compile Remove="Data/BaseStore.cs" />
    <Compile Remove="Data/EntityDBModel.cs" />
    <Compile Remove="Security/RbacSecurity.cs" />
    <Compile Remove="UI/Components/EntityActionModels.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Contracts\Core.Contracts.csproj" />
  </ItemGroup>
</Project>
