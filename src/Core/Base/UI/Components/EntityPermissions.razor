@namespace WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Base.UI.Htmx
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@if (RbacId != Guid.Empty)
{
    <div class="card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Valid Permissions</span>
            <LazyContent Url="@RoleActionUrl">
                <Placeholder>
                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                        Add role
                    </button>
                </Placeholder>
            </LazyContent>
        </div>
        <div class="card-body p-0">
            <LazyContent Url="@($"/{App}/RbacPermissionResponse/permissions/{RbacId}")">
                <Placeholder><div class="p-3 text-muted">Loading permissions...</div></Placeholder>
            </LazyContent>
        </div>
    </div>

}

@code {
    [Parameter, EditorRequired] public Guid RbacId { get; set; }
    [Parameter] public string App { get; set; } = "architecture";

    private string ReturnUrl
    {
        get
        {
            var request = HttpContextAccessor.HttpContext?.Request;
            return request is null ? $"/{App}" : request.Path.ToString() + request.QueryString.ToString();
        }
    }

    private string RoleActionUrl => $"/architecture/RbacPermissionResponse/create-role-action/{RbacId}?return_url={Uri.EscapeDataString(ReturnUrl)}";
}
