@namespace WebAppArchitecture.Base.UI.Components
@typeparam TModel
@using System.Text.Json
@using Microsoft.AspNetCore.Components

<div class="card shadow-sm my-2">
    <div class="card-header">@typeof(TModel).Name</div>
    <div class="card-body"><pre class="mb-0 text-break">@JsonSerializer.Serialize(Model, new JsonSerializerOptions { WriteIndented = true })</pre></div>
</div>

@code {
    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
}
