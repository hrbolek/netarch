@namespace WebAppArchitecture.Base.UI.Components

@if (Model.Actions.Count > 0)
{
    <div class="dropdown d-inline-block">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Model.Label">
            <span aria-hidden="true">&#8942;</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            @foreach (var entry in Model.Actions.OrderBy(x => x.Order).GroupBy(x => x.Group).Select((group, index) => new { group, index }))
            {
                if (entry.index > 0)
                {
                    <li><hr class="dropdown-divider" /></li>
                }

                @foreach (var action in entry.group.OrderBy(x => x.Order))
                {
                    <li>
                        <PermissionGate Allowed="@action.Enabled" DisabledReason="@action.DisabledReason">
                            <EntityActionItem Action="@action" />
                        </PermissionGate>
                    </li>
                }
            }
        </ul>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public EntityActionMenuModel Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }

}
