@namespace WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Base.UI.Routing

<Page Title="Home">
    <div class="container py-4">
        <div class="mb-4">
            <h1 class="h3">Applications</h1>
            <p class="text-muted mb-0">Select an application area.</p>
        </div>

        <div class="row g-3">
            @foreach (var application in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title">@application.Label</h2>
                            <p class="card-text text-muted flex-grow-1">@application.Description</p>
                            <a class="btn btn-primary align-self-start" href="@application.RootUrl">Open</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</Page>

@code {
    [Parameter, EditorRequired] public ApplicationDefinition[] Model { get; set; } = Array.Empty<ApplicationDefinition>();
    [Parameter] public bool IsFragment { get; set; }
}
