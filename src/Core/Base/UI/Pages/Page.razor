@namespace WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Base.UI.Routing
@inject NavigationManager Navigation
@inject IApplicationNavigationRegistry ApplicationNavigation
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://unpkg.com/htmx.org@2.0.8"></script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" href="@(CurrentApplication?.RootUrl ?? "/")">@(CurrentApplication?.Label ?? "WebAppArchitecture")</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    @if (CurrentApplication is not null)
                    {
                        @foreach (var item in CurrentApplication.Navigation)
                        {
                            @if (item.Children is { Count: > 0 })
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@item.Label</a>
                                    <ul class="dropdown-menu">
                                        @foreach (var child in item.Children)
                                        {
                                            @if (child.Separator)
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                            }
                                            else
                                            {
                                                var enabled = IsEnabled(child);
                                                <li>
                                                    <a class="@(enabled ? "dropdown-item" : "dropdown-item disabled")"
                                                       href="@(enabled ? ResolveUrl(child.Url) : "javascript:void(0)")">
                                                        @child.Label
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </li>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.Url))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@ResolveUrl(item.Url)">@item.Label</a>
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        </div>
    </nav>

    @ChildContent
    <script>
        (() => {
            const timers = new WeakMap();

            function buildWhere(fields, term) {
                const pattern = `%${term}%`;
                if (fields.length === 1) {
                    return { [fields[0]]: { _ilike: pattern } };
                }
                return {
                    _or: fields.map(field => ({ [field]: { _ilike: pattern } }))
                };
            }

            async function refreshLookup(input) {
                const root = input.closest('.entity-lookup');
                if (!root) return;

                const select = root.querySelector('[data-entity-lookup-select]');
                const status = root.querySelector('[data-entity-lookup-status]');
                const term = input.value.trim();
                const minChars = Number(root.dataset.minChars || '3');
                const take = Number(root.dataset.take || '20');
                const fields = JSON.parse(root.dataset.searchFields || '[]');
                const listUrl = root.dataset.listUrl;

                if (!select || !listUrl || fields.length === 0) return;

                if (term.length < minChars) {
                    status.textContent = `Type at least ${minChars} characters to search.`;
                    return;
                }

                status.textContent = 'Searching…';
                const where = buildWhere(fields, term);
                const separator = listUrl.includes('?') ? '&' : '?';
                const url = `${listUrl}${separator}where=${encodeURIComponent(JSON.stringify(where))}&take=${encodeURIComponent(take)}`;

                try {
                    const response = await fetch(url, {
                        headers: {
                            'Accept': 'application/json',
                            'X-Response-Type': 'json'
                        }
                    });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const items = await response.json();
                    const previous = select.value;
                    select.replaceChildren();
                    const empty = document.createElement('option');
                    empty.value = '';
                    empty.textContent = 'Select…';
                    select.appendChild(empty);
                    for (const item of items) {
                        const option = document.createElement('option');
                        option.value = item.id;
                        option.textContent = item.visual_label || item.name || item.id;
                        select.appendChild(option);
                    }
                    if (previous && [...select.options].some(x => x.value === previous)) {
                        select.value = previous;
                    }
                    status.textContent = `${items.length} result${items.length === 1 ? '' : 's'}.`;
                } catch (error) {
                    status.textContent = `Search failed: ${error.message}`;
                }
            }

            document.addEventListener('input', event => {
                const input = event.target.closest?.('[data-entity-lookup-search]');
                if (!input) return;
                const old = timers.get(input);
                if (old) clearTimeout(old);
                timers.set(input, setTimeout(() => refreshLookup(input), 300));
            });
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

@code {
    [Parameter] public string Title { get; set; } = "WebAppArchitecture";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ApplicationDefinition? CurrentApplication
    {
        get
        {
            var appKey = ParseCurrentRoute().appKey;
            return appKey is null ? null : ApplicationNavigation.Get(appKey);
        }
    }

    private bool IsEnabled(ApplicationNavigationItem item)
    {
        if (item.RequiresResponseModel is null)
            return true;

        var route = ParseCurrentRoute();
        return string.Equals(route.responseModel, item.RequiresResponseModel, StringComparison.OrdinalIgnoreCase)
            && route.id is not null;
    }

    private string ResolveUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "#";

        var route = ParseCurrentRoute();
        return route.id is null
            ? url
            : url.Replace("{id}", route.id.Value.ToString(), StringComparison.OrdinalIgnoreCase);
    }

    private (string? appKey, string? responseModel, string? operation, Guid? id) ParseCurrentRoute()
    {
        var path = new Uri(Navigation.Uri, UriKind.Absolute).AbsolutePath.Trim('/');
        if (string.IsNullOrWhiteSpace(path))
            return (null, null, null, null);

        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var appKey = segments.Length >= 1 ? segments[0] : null;
        var responseModel = segments.Length >= 2 ? segments[1] : null;
        var operation = segments.Length >= 3 ? segments[2] : null;

        Guid? id = null;
        if (segments.Length >= 4 && Guid.TryParse(segments[3], out var parsed))
            id = parsed;

        return (appKey, responseModel, operation, id);
    }
}
