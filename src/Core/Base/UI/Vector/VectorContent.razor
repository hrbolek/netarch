@namespace WebAppArchitecture.Base.UI.Vector
@inject WebAppArchitecture.Base.UI.Routing.IEntityRouteRegistry EntityRoutes
@using WebAppArchitecture.Base.Data

<div class="d-grid gap-3">
    @if (Model.Items.Count == 0)
    {
        <div class="text-muted">@(Model.PageInfo?.HasFilter == true ? "No items match the current filter." : "No items.")</div>
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            if (Model.ItemComponentType is not null)
            {
                <DynamicComponent Type="@Model.ItemComponentType" Parameters="@CreateParameters(item)" />
            }
            else
            {
                <a href="@(EntityUrl(item, "view"))">@item.visual_label</a>
            }
        }
    }
</div>
<VectorPager PageInfo="@Model.PageInfo" ItemCount="@Model.Items.Count" TargetId="@Model.TargetId" />

@code {
    private string EntityUrl(IEntityDTOModel item, string operation)
        => EntityRoutes.GetUrl(item.GetType(), item.id,
            app: string.IsNullOrWhiteSpace(Model.App) ? null : Model.App,
            entity: string.IsNullOrWhiteSpace(Model.EntityType) ? null : Model.EntityType,
            operation: operation);

    [Parameter, EditorRequired]
    public VectorContentViewModel Model { get; set; } = default!;

    private static IDictionary<string, object?> CreateParameters(IEntityDTOModel item)
        => new Dictionary<string, object?> { ["Model"] = item };
}
