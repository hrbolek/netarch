@namespace WebAppArchitecture.Base.UI.Vector

<div class="row g-2">
    @if (Model.Items.Count == 0)
    {
        <div class="col-12 text-muted">@(Model.PageInfo?.HasFilter == true ? "No items match the current filter." : "No items.")</div>
    }
    else
    {
        @foreach (var item in Model.Items)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100">
                    <div class="card-body py-2 px-3 d-flex justify-content-between align-items-center gap-2">
                        <a class="text-decoration-none text-truncate" href="@($"/{Model.App}/{Model.EntityType}/view/{item.id}")">
                            @item.visual_label
                        </a>
                        <EntityActionSlot Url="@($"/{Model.App}/{Model.EntityType}/actions/{item.id}")" />
                    </div>
                </div>
            </div>
        }
    }
</div>

<VectorPager PageInfo="@Model.PageInfo" ItemCount="@Model.Items.Count" TargetId="@Model.TargetId" />

@code {
    [Parameter, EditorRequired]
    public VectorContentViewModel Model { get; set; } = default!;
}
