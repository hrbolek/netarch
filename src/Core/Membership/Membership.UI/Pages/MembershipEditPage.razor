@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Membership.Models
@using WebAppArchitecture.Membership.UI.Components

@namespace WebAppArchitecture.Membership.UI.Pages

<PageEdit TModel="MembershipResponse" Model="@Model" Title="Editace: Membership">
    <ChildContent Context="item">
        <MembershipLargeCard Model="@item">
            <ChildContent Context="largeItem">
                <MembershipEditableCard Model="@largeItem" />
            </ChildContent>
        </MembershipLargeCard>
    </ChildContent>
</PageEdit>

@code {
    [Parameter, EditorRequired]
    public MembershipResponse Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
