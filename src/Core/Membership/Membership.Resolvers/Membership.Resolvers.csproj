<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ASP.NET Core RouteHandlerAnalyzer throws AD0001 on generic minimal API resolver mappings; suppress only this analyzer exception. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <RootNamespace>WebAppArchitecture.Membership.Resolvers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Base/Base.csproj" />
    <ProjectReference Include="../Membership.Models/Membership.Models.csproj" />
    <ProjectReference Include="../Membership.Services/Membership.Services.csproj" />
    <ProjectReference Include="../Membership.UI/Membership.UI.csproj" />
  </ItemGroup>
</Project>
