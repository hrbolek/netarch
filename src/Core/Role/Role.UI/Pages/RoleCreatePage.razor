@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Base.UI.Components
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@namespace WebAppArchitecture.Role.UI.Pages

<Page Title="Create role">
    <div class="container py-3">
        <h1 class="h4 mb-3">New role</h1>
        <form method="post" action="/architecture/RoleResponse/create-form" class="card card-body">
            <input type="hidden" name="return_url" value="@ReturnUrl" />

            @if (ContextGroupId is Guid groupId)
            {
                <input type="hidden" name="group_id" value="@groupId" />
                <div class="mb-3"><label class="form-label">Group</label><input class="form-control" value="@groupId" readonly /><div class="form-text">The target group is fixed by the context action.</div></div>
            }
            else
            {
                <div class="mb-3"><EntityLookupSelect Name="group_id" Label="Group" ListUrl="/architecture/GroupResponse/list?operation=create" SearchFields="@GroupFields" MinChars="2" Take="20" HelpText="Only groups where the acting user has create permission are returned." /></div>
            }

            @if (ContextUserId is Guid userId)
            {
                <input type="hidden" name="user_id" value="@userId" />
                <div class="mb-3"><label class="form-label">User</label><input class="form-control" value="@userId" readonly /><div class="form-text">The user is fixed by the context action.</div></div>
            }
            else
            {
                <div class="mb-3"><EntityLookupSelect Name="user_id" Label="User" ListUrl="/architecture/UserResponse/list" SearchFields="@UserFields" MinChars="3" Take="20" /></div>
            }

            <div class="mb-3"><EntityLookupSelect Name="role_type_id" Label="Role type" ListUrl="/architecture/RoleTypeResponse/list" SearchFields="@RoleTypeFields" MinChars="2" Take="20" /></div>
            <div class="form-check mb-3"><input class="form-check-input" type="checkbox" name="is_deputy" value="true" id="role-is-deputy-page" /><label class="form-check-label" for="role-is-deputy-page">Deputy role</label></div>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Valid from</label><input class="form-control" type="datetime-local" name="valid_from" /></div>
                <div class="col-md-6"><label class="form-label">Valid to</label><input class="form-control" type="datetime-local" name="valid_to" /></div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Create</button>
                @if (!string.IsNullOrWhiteSpace(ReturnUrl)) { <a class="btn btn-outline-secondary" href="@ReturnUrl">Cancel</a> }
            </div>
        </form>
    </div>
</Page>

@code {
    private static readonly string[] GroupFields = ["Name"];
    private static readonly string[] UserFields = ["Name", "surname", "email"];
    private static readonly string[] RoleTypeFields = ["name"];
    private Guid? ContextGroupId => ParseGuid("group_id");
    private Guid? ContextUserId => ParseGuid("user_id");
    private string ReturnUrl => HttpContextAccessor.HttpContext?.Request.Query["return_url"].ToString() ?? string.Empty;
    private Guid? ParseGuid(string key) => Guid.TryParse(HttpContextAccessor.HttpContext?.Request.Query[key].ToString(), out var value) ? value : null;
}
