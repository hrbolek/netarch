@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Role.Models

@namespace WebAppArchitecture.Role.UI.Components

<MediumCard TModel="RoleResponse" Model="@Model" HeaderText="Role">
    <ChildContent Context="item">
        <Attribute TModel="RoleResponse" Item="@item" Label="ID" AttributeName="id" />
        <Attribute TModel="RoleResponse" Item="@item" Label="Group">
            <EntityLink TModel="RoleResponse" Model="@item" Type="GroupResponse" EntityId="@item.group_id">
                <ChildContent Context="_">@(item.group_name ?? item.group_id.ToString())</ChildContent>
            </EntityLink>
        </Attribute>
        <Attribute TModel="RoleResponse" Item="@item" Label="User">
            <EntityLink TModel="RoleResponse" Model="@item" Type="UserResponse" EntityId="@item.user_id">
                <ChildContent Context="_">@(item.user_name ?? item.user_id.ToString())</ChildContent>
            </EntityLink>
        </Attribute>
        <Attribute TModel="RoleResponse" Item="@item" Label="Role Type" AttributeName="role_type" />
        <Attribute TModel="RoleResponse" Item="@item" Label="Valid From">
            <span>@item.valid_from.ToString("yyyy-MM-dd HH:mm zzz")</span>
        </Attribute>
        <Attribute TModel="RoleResponse" Item="@item" Label="Valid To">
            @if (item.valid_to is null)
            {
                <span class="text-muted">without end</span>
            }
            else
            {
                <span>@item.valid_to.Value.ToString("yyyy-MM-dd HH:mm zzz")</span>
            }
        </Attribute>
        <Attribute TModel="RoleResponse" Item="@item" Label="Deputy" AttributeName="is_deputy" />
        <Attribute TModel="RoleResponse" Item="@item" Label="Delegated By Role">
            @if (item.delegated_by_role_id is null)
            {
                <span class="text-muted">none</span>
            }
            else
            {
                <EntityLink TModel="RoleResponse" Model="@item" Type="RoleResponse" EntityId="@item.delegated_by_role_id.Value">
                    <ChildContent Context="_">@(item.delegated_by_role_type ?? item.delegated_by_role_id.Value.ToString())</ChildContent>
                </EntityLink>
            }
        </Attribute>
        <Attribute TModel="RoleResponse" Item="@item" Label="Created">
            <span>@item.created_at.ToString("yyyy-MM-dd HH:mm zzz")</span>
        </Attribute>
        <Attribute TModel="RoleResponse" Item="@item" Label="Updated">
            <span>@item.updated_at.ToString("yyyy-MM-dd HH:mm zzz")</span>
        </Attribute>
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired]
    public RoleResponse Model { get; set; } = default!;
}
