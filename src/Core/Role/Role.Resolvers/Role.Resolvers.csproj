<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ASP.NET Core RouteHandlerAnalyzer throws AD0001 on generic minimal API resolver mappings; suppress only this analyzer exception. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <RootNamespace>WebAppArchitecture.Role.Resolvers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Base/Base.csproj" />
    <ProjectReference Include="../Role.Models/Role.Models.csproj" />
    <ProjectReference Include="../Role.Services/Role.Services.csproj" />
    <ProjectReference Include="../Role.UI/Role.UI.csproj" />
  </ItemGroup>
</Project>
