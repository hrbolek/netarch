@using WebAppArchitecture.User.Models
@using WebAppArchitecture.Base.UI.Components

@namespace WebAppArchitecture.User.UI.Components

<MediumCard TModel="UserResponse" Model="@Model" ActionsUrl="@($"/architecture/UserResponse/actions/{Model.id}")" HeaderText="Uživatel">
    <ChildContent Context="item">
        <Attribute TModel="UserResponse" Item="@item" Label="ID" AttributeName="id" />
        <Attribute TModel="UserResponse" Item="@item" Label="Name" AttributeName="Name" />
        <Attribute TModel="UserResponse" Item="@item" Label="Surname" AttributeName="surname" />
        <Attribute TModel="UserResponse" Item="@item" Label="E-mail" AttributeName="email" />
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired]
    public UserResponse Model { get; set; } = default!;
}
