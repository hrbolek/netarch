<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ASP.NET Core RouteHandlerAnalyzer throws AD0001 on generic minimal API resolver mappings; suppress only this analyzer exception. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <RootNamespace>WebAppArchitecture.User.Resolvers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Base/Base.csproj" />
    <ProjectReference Include="../../Group/Group.Models/Group.Models.csproj" />
    <ProjectReference Include="../../Group/Group.Services/Group.Services.csproj" />
    <ProjectReference Include="../../Membership/Membership.Models/Membership.Models.csproj" />
    <ProjectReference Include="../../Membership/Membership.Services/Membership.Services.csproj" />
    <ProjectReference Include="../../Role/Role.Models/Role.Models.csproj" />
    <ProjectReference Include="../../Role/Role.Services/Role.Services.csproj" />
    <ProjectReference Include="../User.Models/User.Models.csproj" />
    <ProjectReference Include="../User.Services/User.Services.csproj" />
    <ProjectReference Include="../User.UI/User.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Contracts\Core.Contracts.csproj" />
  </ItemGroup>
</Project>
