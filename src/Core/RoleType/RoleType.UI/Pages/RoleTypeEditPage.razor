@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.RoleType.Models
@using WebAppArchitecture.RoleType.UI.Components

@namespace WebAppArchitecture.RoleType.UI.Pages

<PageEdit TModel="RoleTypeResponse" Model="@Model" Title="Editace: RoleType">
    <ChildContent Context="item">
        <RoleTypeLargeCard Model="@item">
            <ChildContent Context="largeItem">
                <RoleTypeEditableCard Model="@largeItem" />
            </ChildContent>
        </RoleTypeLargeCard>
    </ChildContent>
</PageEdit>

@code {
    [Parameter, EditorRequired]
    public RoleTypeResponse Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
