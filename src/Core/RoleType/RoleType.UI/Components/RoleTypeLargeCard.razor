@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.RoleType.Models

@namespace WebAppArchitecture.RoleType.UI.Components

<LargeCard TModel="RoleTypeResponse" Model="@Model" HeaderText="RoleType">
    <SideContent Context="item">
        <RoleTypeMediumCard Model="@item" />
        <EntityPermissions RbacId="@item.rbacobject_id" />
    </SideContent>

    <ChildContent Context="item">
        @if (ChildContent is not null)
        {
            @ChildContent(item)
        }
    </ChildContent>
</LargeCard>

@code {
    [Parameter, EditorRequired]
    public RoleTypeResponse Model { get; set; } = default!;

    [Parameter]
    public RenderFragment<RoleTypeResponse>? ChildContent { get; set; }
}
