<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ASP.NET Core RouteHandlerAnalyzer throws AD0001 on generic minimal API resolver mappings; suppress only this analyzer exception. -->
    <NoWarn>$(NoWarn);AD0001</NoWarn>
    <RootNamespace>WebAppArchitecture.Group.Resolvers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../Base/Base.csproj" />
    <ProjectReference Include="../Group.Models/Group.Models.csproj" />
    <ProjectReference Include="../Group.Services/Group.Services.csproj" />
    <ProjectReference Include="../Group.UI/Group.UI.csproj" />
    <ProjectReference Include="../../Role/Role.Models/Role.Models.csproj" />
    <ProjectReference Include="../../Role/Role.Services/Role.Services.csproj" />
    <ProjectReference Include="../../Membership/Membership.Models/Membership.Models.csproj" />
    <ProjectReference Include="../../Membership/Membership.Services/Membership.Services.csproj" />
  </ItemGroup>
</Project>
