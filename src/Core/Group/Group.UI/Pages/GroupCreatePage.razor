@using WebAppArchitecture.Base.UI.Pages

@namespace WebAppArchitecture.Group.UI.Pages

<Page Title="Vytvorit skupinu">
    <div class="container py-3">
        <h1 class="h4 mb-3">Nova skupina</h1>
        <form method="post" action="/architecture/GroupResponse/create-form" class="card card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" name="Name" required />
            </div>
            <button type="submit" class="btn btn-primary">Vytvorit</button>
        </form>
    </div>
</Page>
