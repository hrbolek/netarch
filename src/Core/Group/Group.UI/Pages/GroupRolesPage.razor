@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Group.Models
@using WebAppArchitecture.Group.UI.Components
@using WebAppArchitecture.Role.Models
@using WebAppArchitecture.Role.UI.Components

@namespace WebAppArchitecture.Group.UI.Pages

<Page Title="@Model.Title">
    <GroupLargeCard Model="@Model.Parent">
        <ChildContent Context="item">
            <EntityRelationSection TItem="RoleResponse" TItemComponent="RoleMediumCard" Items="@Model.Items" Title="@Model.SectionTitle" />
        </ChildContent>
    </GroupLargeCard>
</Page>

@code {
    [Parameter, EditorRequired]
    public EntityRelationsViewModel<GroupResponse, RoleResponse> Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
