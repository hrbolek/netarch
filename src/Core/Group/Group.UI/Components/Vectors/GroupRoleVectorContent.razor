@using WebAppArchitecture.Base.Data
@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Base.UI.Vector
@using WebAppArchitecture.Group.Models
@using WebAppArchitecture.Role.Models
@using WebAppArchitecture.Role.UI.Components
@namespace WebAppArchitecture.Group.UI.Components.Vectors
@typeparam TPresentation where TPresentation : IComponent

<DynamicComponent Type="@typeof(TPresentation)" Parameters="@PresentationParameters" />

@code {
    [Parameter, EditorRequired]
    public EntityRelationsViewModel<GroupResponse, RoleResponse> Model { get; set; } = default!;

    private VectorContentViewModel PresentationModel => new(
        Model.SectionTitle,
        nameof(RoleResponse),
        Model.Items.Cast<IEntityDTOModel>().ToArray(),
        typeof(RoleMediumCard),
        new VectorColumnDefinition[]
        {
            new("is_deputy", "Deputy"),
            new("valid_from", "Valid from"),
            new("valid_to", "Valid to")
        },
        ItemLabelComponentType: typeof(RoleEntityLabel),
        PageInfo: Model.PageInfo,
        TargetId: $"group-vector-{Model.Parent.id:N}");

    private IDictionary<string, object?> PresentationParameters
        => new Dictionary<string, object?> { ["Model"] = PresentationModel };
}
