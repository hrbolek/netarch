@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Group.Models

@namespace WebAppArchitecture.Group.UI.Components

<MediumCard TModel="GroupResponse" Model="@Model" ActionsUrl="@($"/architecture/GroupResponse/actions/{Model.id}")" HeaderText="Skupina">
    <ChildContent Context="item">
        <Attribute TModel="GroupResponse" Item="@item" Label="ID" AttributeName="id" />
        <Attribute TModel="GroupResponse" Item="@item" Label="Name" AttributeName="Name" />
        <Attribute TModel="GroupResponse" Item="@item" Label="Master Group">
            @if (item.master_group_id is null)
            {
                <span class="text-muted">none</span>
            }
            else
            {
                <EntityLink TModel="GroupResponse" Model="@item" Type="GroupResponse" EntityId="@item.master_group_id.Value">
                    <ChildContent Context="_">@(item.master_group_name ?? item.master_group_id.Value.ToString())</ChildContent>
                </EntityLink>
            }
        </Attribute>
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired]
    public GroupResponse Model { get; set; } = default!;
}
