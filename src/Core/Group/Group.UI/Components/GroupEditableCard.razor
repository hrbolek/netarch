@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Group.Models

@namespace WebAppArchitecture.Group.UI.Components

<div id="group-edit-root-@Model.id">
    <form hx-post="@($"/architecture/GroupResponse/update/{Model.id}")"
          hx-target="@($"#group-edit-root-{Model.id}")"
          hx-swap="outerHTML">
        <input type="hidden" name="updated_at" value="@Model.updated_at.ToString("O")" />
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control"
                   name="Name"
                   value="@Model.Name"
                   hx-post="@($"/architecture/GroupResponse/update/{Model.id}")"
                   hx-trigger="keyup changed delay:600ms"
                   hx-include="closest form"
                   hx-target="@($"#group-edit-root-{Model.id}")"
                   hx-swap="outerHTML" />
        </div>
        <button class="btn btn-primary" type="submit">Uložit</button>
    </form>
</div>

@code {
    [Parameter, EditorRequired]
    public GroupResponse Model { get; set; } = default!;
}
