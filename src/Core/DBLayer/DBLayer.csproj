<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebAppArchitecture.DBLayer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <ProjectReference Include="../Base/Base.csproj" />
  </ItemGroup>

  <!-- Refactoring compatibility: exclude source files superseded by per-type files.
       SDK default glob otherwise compiles stale sources when ZIPs are overlaid. -->
  <ItemGroup>
    <Compile Remove="DBModels.cs" />
    <Compile Remove="DigitalProcessesDBModels.cs" />
    <Compile Remove="EfStores.cs" />
    <Compile Remove="StoreContracts.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Contracts\Core.Contracts.csproj" />
  </ItemGroup>
</Project>
