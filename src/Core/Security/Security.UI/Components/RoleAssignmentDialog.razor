@namespace WebAppArchitecture.Security.UI.Components
@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Security.Models

<form class="modal-content" method="post" action="/architecture/RbacPermissionResponse/create-role-form/@Model.rbacobject_id">
    <input type="hidden" name="return_url" value="@Model.return_url" />

    <div class="modal-header">
        <h5 class="modal-title">Create role</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div class="mb-3">
            <EntityLookupSelect Name="user_id"
                                Label="User"
                                ListUrl="/architecture/UserResponse/list"
                                SearchFields="@UserSearchFields"
                                MinChars="3"
                                Take="20"
                                Required="true"
                                SearchPlaceholder="Type name, surname or e-mail…" />
        </div>

        <div class="mb-3">
            <EntityLookupSelect Name="role_type_id"
                                Label="Role"
                                ListUrl="/architecture/RoleTypeResponse/list"
                                SearchFields="@RoleTypeSearchFields"
                                MinChars="2"
                                Take="20"
                                Required="true"
                                SearchPlaceholder="Type role name…" />
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Valid from</label>
                <input class="form-control" type="datetime-local" name="valid_from" value="@Model.default_valid_from.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Valid to</label>
                <input class="form-control" type="datetime-local" name="valid_to" />
            </div>
        </div>
        <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" value="true" name="is_deputy" id="role-is-deputy" />
            <label class="form-check-label" for="role-is-deputy">Deputy role</label>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create role</button>
    </div>
</form>

@code {
    private static readonly string[] UserSearchFields = ["Name", "surname", "email"];
    private static readonly string[] RoleTypeSearchFields = ["name"];

    [Parameter, EditorRequired] public RoleAssignmentDialogResponse Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
}
