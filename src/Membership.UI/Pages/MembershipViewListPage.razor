@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Membership.Models
@using WebAppArchitecture.Membership.UI.Components

@namespace WebAppArchitecture.Membership.UI.Pages

<PageViewList TModel="MembershipResponse" Items="@Model" Title="Memberships">
    <ChildContent Context="item">
        <MembershipMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired]
    public MembershipResponse[] Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
