@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Membership.Models

@namespace WebAppArchitecture.Membership.UI.Components

<MediumCard TModel="MembershipResponse" Model="@Model" HeaderText="Membership">
    <ChildContent Context="item">
        <Attribute TModel="MembershipResponse" Item="@item" Label="ID" AttributeName="id" />
        <Attribute TModel="MembershipResponse" Item="@item" Label="Group">
            <EntityLink TModel="MembershipResponse" Model="@item" Type="GroupResponse" EntityId="@item.group_id">
                <ChildContent Context="_">@(item.group_name ?? item.group_id.ToString())</ChildContent>
            </EntityLink>
        </Attribute>
        <Attribute TModel="MembershipResponse" Item="@item" Label="User">
            <EntityLink TModel="MembershipResponse" Model="@item" Type="UserResponse" EntityId="@item.user_id">
                <ChildContent Context="_">@(item.user_name ?? item.user_id.ToString())</ChildContent>
            </EntityLink>
        </Attribute>
        <Attribute TModel="MembershipResponse" Item="@item" Label="Valid From" AttributeName="valid_from" />
        <Attribute TModel="MembershipResponse" Item="@item" Label="Valid To" AttributeName="valid_to" />
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired]
    public MembershipResponse Model { get; set; } = default!;
}
