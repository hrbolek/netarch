@using WebAppArchitecture.DigitalProcesses.Models.FormNodeType
@namespace WebAppArchitecture.DigitalProcesses.UI.FormNodeType.Components
@using System.Text.Json
@using WebAppArchitecture.Base.UI.Components

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Title</span>
        <EntityLink TModel="FormNodeTypeResponse" Model="@Model" App="digital-processes" />
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted small">id</dt>
            <dd class="col-sm-8 text-break">@(Model.id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">parent type id</dt>
            <dd class="col-sm-8 text-break">@((Model.parent_type_id?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">name</dt>
            <dd class="col-sm-8 text-break">@(Model.name.ToString())</dd>
            <dt class="col-sm-4 text-muted small">renderer key</dt>
            <dd class="col-sm-8 text-break">@(Model.renderer_key.ToString())</dd>
            <dt class="col-sm-4 text-muted small">can have children</dt>
            <dd class="col-sm-8 text-break">@(Model.can_have_children.ToString())</dd>
            <dt class="col-sm-4 text-muted small">can have value</dt>
            <dd class="col-sm-8 text-break">@(Model.can_have_value.ToString())</dd>
            <dt class="col-sm-4 text-muted small">can repeat</dt>
            <dd class="col-sm-8 text-break">@(Model.can_repeat.ToString())</dd>
            <dt class="col-sm-4 text-muted small">configuration schema json</dt>
            <dd class="col-sm-8 text-break">@((Model.configuration_schema_json?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">rbacobject id</dt>
            <dd class="col-sm-8 text-break">@(Model.rbacobject_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created at</dt>
            <dd class="col-sm-8 text-break">@(Model.created_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated at</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created by</dt>
            <dd class="col-sm-8 text-break">@(Model.created_by.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated by</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_by.ToString())</dd>
        </dl>
        <details class="mt-3"><summary class="small text-muted">Raw JSON (diagnostics)</summary><pre class="small mt-2">@JsonSerializer.Serialize(Model, JsonOptions)</pre></details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FormNodeTypeResponse Model { get; set; } = default!;
    [Parameter] public string Title { get; set; } = typeof(FormNodeTypeResponse).Name;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
