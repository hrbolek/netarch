@using WebAppArchitecture.DigitalProcesses.Models.FormNodeType
@using WebAppArchitecture.DigitalProcesses.UI.FormNodeType.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.FormNodeType.Pages

<PageViewList TModel="FormNodeTypeResponse" Items="@Model" Title="Form node types" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <FormNodeTypeMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public FormNodeTypeResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
