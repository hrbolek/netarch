@using WebAppArchitecture.DigitalProcesses.UI.Request.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.ProcessDefinitionVersion.Pages

<Page Title="Test procesu">
    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
            <div>
                <h1 class="h3 mb-1">Test procesu · verze @Model.ProcessVersion.version</h1>
                <div class="text-muted">
                    Verze @(Model.ProcessVersion.is_published ? "publikovaná" : "rozpracovaná")
                    · Workflow @Model.Workflow.version.version
                    · Form @Model.Form.form.version
                </div>
            </div>
            <a class="btn btn-outline-secondary" href="@($"/digital-processes/ProcessDefinitionVersionResponse/view/{Model.ProcessVersion.id}")">Zpět na verzi procesu</a>
        </div>
        <div class="alert alert-info py-2">
            Testovací Request: @Model.Request.request.id · vyplňovaná data se ukládají průběžně. Přechody mění stav a vytvářejí historii jako při běžném běhu procesu.
        </div>
        <RequestWorkspace Model="@Model.Workspace" ReturnToRequest="false" />
    </div>
</Page>

@code {
    [Parameter, EditorRequired] public ProcessVersionTestPageModel Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
}
