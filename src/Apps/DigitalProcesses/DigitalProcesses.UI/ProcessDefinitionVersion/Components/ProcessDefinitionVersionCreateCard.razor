@namespace WebAppArchitecture.DigitalProcesses.UI.ProcessDefinitionVersion.Components

<div class="card shadow-sm">
    <div class="card-header fw-semibold">@Model.Title</div>
    <form method="post" action="@Model.Action" class="card-body">
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "process_definition_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "form_definition_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "form_version_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "workflow_definition_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "workflow_version_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "target_group_type_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "publish")' />
        <div><button type="submit" class="btn btn-primary">@Model.SubmitLabel</button></div>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public DigitalProcessCreatePageModel Model { get; set; } = default!;
}
