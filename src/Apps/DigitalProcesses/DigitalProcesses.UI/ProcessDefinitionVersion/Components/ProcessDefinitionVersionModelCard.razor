@using WebAppArchitecture.DigitalProcesses.Models.ProcessDefinitionVersion
@namespace WebAppArchitecture.DigitalProcesses.UI.ProcessDefinitionVersion.Components
@using System.Text.Json
@using WebAppArchitecture.Base.UI.Components

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Title</span>
        <EntityLink TModel="ProcessDefinitionVersionResponse" Model="@Model" App="digital-processes" />
    </div>
    <div class="card-body">
        <form method="post"
              action="/digital-processes/ProcessDefinitionVersionResponse/test/@Model.id"
              class="mb-3"
              onsubmit="return confirm('Vytvořit testovací žádost pro tuto verzi procesu?');">
            <button type="submit" class="btn btn-sm btn-outline-primary">Testovat tuto verzi</button>
        </form>
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted small">id</dt>
            <dd class="col-sm-8 text-break">@(Model.id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">process definition id</dt>
            <dd class="col-sm-8 text-break">@(Model.process_definition_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">form version id</dt>
            <dd class="col-sm-8 text-break">@(Model.form_version_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">workflow version id</dt>
            <dd class="col-sm-8 text-break">@(Model.workflow_version_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">version</dt>
            <dd class="col-sm-8 text-break">@(Model.version.ToString())</dd>
            <dt class="col-sm-4 text-muted small">is published</dt>
            <dd class="col-sm-8 text-break">@(Model.is_published.ToString())</dd>
            <dt class="col-sm-4 text-muted small">published at</dt>
            <dd class="col-sm-8 text-break">@((Model.published_at?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">rbacobject id</dt>
            <dd class="col-sm-8 text-break">@(Model.rbacobject_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created at</dt>
            <dd class="col-sm-8 text-break">@(Model.created_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated at</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created by</dt>
            <dd class="col-sm-8 text-break">@(Model.created_by.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated by</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_by.ToString())</dd>
            <dt class="col-sm-4 text-muted small">target group type id</dt>
            <dd class="col-sm-8 text-break">@((Model.target_group_type_id?.ToString() ?? "\u2014"))</dd>
        </dl>
        <details class="mt-3"><summary class="small text-muted">Raw JSON (diagnostics)</summary><pre class="small mt-2">@JsonSerializer.Serialize(Model, JsonOptions)</pre></details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ProcessDefinitionVersionResponse Model { get; set; } = default!;
    [Parameter] public string Title { get; set; } = typeof(ProcessDefinitionVersionResponse).Name;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
