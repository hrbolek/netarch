@using WebAppArchitecture.DigitalProcesses.Models.FormNode
@using WebAppArchitecture.DigitalProcesses.Models.FormVersion
@using WebAppArchitecture.DigitalProcesses.UI.FormNode.Components
@using WebAppArchitecture.DigitalProcesses.UI.FormVersion.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.FormVersion.Components

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-1">Form designer · @(Editor.Model.root_node_id is Guid rootId ? Editor.Model.designer.nodes.Single(x => x.id == rootId).label ?? Editor.Model.designer.nodes.Single(x => x.id == rootId).key : Editor.Model.designer.form.visual_label)</h1>
        <div class="text-muted small">Version @Editor.Model.designer.form.version @(Editor.Model.designer.form.is_published ? "· published" : "· draft")</div>
    </div>
    <div class="btn-group">
        @if (!Editor.Model.designer.form.is_published && !Editor.Model.test_mode)
        {
            <button type="button" class="btn btn-outline-success" data-open-node-wizard>Vložit prvek</button>
        }
        <a class="btn @(Editor.Model.test_mode ? "btn-outline-primary" : "btn-primary")" href="@Editor.DesignerUrl">Design</a>
        <a class="btn @(Editor.Model.test_mode ? "btn-primary" : "btn-outline-primary")" href="@Editor.TestUrl">Test</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FormNodeEditorView Editor { get; set; } = default!;
}
