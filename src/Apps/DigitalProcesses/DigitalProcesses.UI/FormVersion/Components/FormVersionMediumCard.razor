@using WebAppArchitecture.DigitalProcesses.Models.FormVersion
@namespace WebAppArchitecture.DigitalProcesses.UI.FormVersion.Components
<MediumCard TModel="FormVersionResponse" Model="@Model" HeaderText="FormVersion" ActionsUrl="@($"/digital-processes/FormVersionResponse/actions/{Model.id}")">
    <ChildContent Context="item">
        <Attribute TModel="FormVersionResponse" Item="@item" Label="visual label" AttributeValue="@item.visual_label" />
        <Attribute TModel="FormVersionResponse" Item="@item" Label="version" AttributeValue="@item.version" />
        <Attribute TModel="FormVersionResponse" Item="@item" Label="is published" AttributeValue="@item.is_published" />
        <Attribute TModel="FormVersionResponse" Item="@item" Label="id" AttributeValue="@item.id" />
        <FormVersionForeignKeyLinks Model="@item" />
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired] public FormVersionResponse Model { get; set; } = default!;
}
