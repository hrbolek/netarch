@using WebAppArchitecture.DigitalProcesses.Models.FormVersion
@using WebAppArchitecture.DigitalProcesses.UI.FormVersion.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.FormVersion.Pages

<PageViewList TModel="FormVersionResponse" Items="@Model" Title="Form versions" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <FormVersionMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public FormVersionResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
