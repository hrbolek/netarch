@using WebAppArchitecture.DigitalProcesses.Models.FormVersion
@using WebAppArchitecture.DigitalProcesses.UI.FormVersion.Components
@using WebAppArchitecture.DigitalProcesses.UI.Shared.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.FormVersion.Pages
<Page Title="RTF šablony formuláře">
<FormVersionLargeCard Model="@Model">
<ChildContent Context="version">
    <h1 class="h4">RTF šablony · verze @version.version</h1>
    <p class="text-muted">Šablony náleží konkrétní verzi formuláře. Úprava vytváří novou neměnnou revizi.</p>
    <div id="templates" class="list-group mb-4">
        @if (version.templates is { Count: > 0 } templates)
        {
            @foreach (var template in templates)
            {
                <div class="list-group-item">
                    <a href="@($"/digital-processes/RtfTemplate/{template.Id}")">@template.Name</a>
                    <a class="ms-3" href="@($"/digital-processes/document-templates/{template.Id}/revisions")">Revize (JSON)</a>
                </div>
            }
        }
        else
        {
            <span>Zatím žádná šablona.</span>
        }
    </div>
    @if (MayEdit)
    {
        <section class="card mb-4"><div class="card-body">
            <h2 class="h5">Nahrát novou RTF šablonu</h2>
            <label class="form-label">Název <input id="template-name" class="form-control" value="Rozhodnutí" /></label>
            <label class="form-label">RTF soubor <input id="template-file" type="file" accept=".rtf,application/rtf" class="form-control" /></label>
            <button id="upload" class="btn btn-primary" type="button">Nahrát šablonu</button>
            <button id="generate" class="btn btn-outline-secondary" type="button">Vygenerovat ze schématu</button>
        </div></section>
    }
    else
    {
        <div class="alert alert-info">Publikovaná verze nebo chybějící oprávnění Update: pouze čtení.</div>
    }
    <section class="card"><div class="card-body"><h2 class="h5">AI asistent tvorby šablony</h2>
        <p class="text-muted">Podpora analýzy DOCX/RTF/PDF předloh je připravována.</p>
        <input type="file" class="form-control mb-2" disabled aria-label="Vzorový dokument pro AI" />
        <button type="button" class="btn btn-outline-secondary" disabled>Analyzovat vzor pomocí AI (připravuje se)</button>
    </div></section>
    <div id="status" role="status" class="mt-3 small"></div>
</ChildContent>
</FormVersionLargeCard>
</Page>
<script>
(() => {
    const root='/digital-processes', version='@Model.id', status=document.getElementById('status');
    async function reload(){
        const r=await fetch(`${root}/FormVersionResponse/rtf-templates/${version}`,{headers:{Accept:'application/json'}});
        if(!r.ok)throw Error('HTTP '+r.status);
        const items=await r.json(), list=document.getElementById('templates');list.replaceChildren();
        for(const t of items){
            const id=t.id??t.Id, name=t.name??t.Name, row=document.createElement('div');row.className='list-group-item';
            const link=document.createElement('a');link.href=`${root}/RtfTemplate/${id}`;link.textContent=name;row.append(link);
            const revisions=document.createElement('a');revisions.className='ms-3';revisions.href=`${root}/document-templates/${id}/revisions`;revisions.textContent='Revize (JSON)';row.append(revisions);list.append(row);
        }
        if(!items.length)list.textContent='Zatím žádná šablona.';
    }
    const upload=document.getElementById('upload');if(upload)upload.onclick=async()=>{try{
        const f=document.getElementById('template-file').files[0];if(!f)throw Error('Vyber RTF soubor.');
        const name=encodeURIComponent(document.getElementById('template-name').value);
        const r=await fetch(`${root}/FormVersionResponse/rtf-templates/${version}?name=${name}`,{method:'POST',headers:{'Content-Type':'application/rtf'},body:f});
        if(!r.ok)throw Error(await r.text());status.textContent='Šablona uložena.';await reload();
    }catch(e){status.textContent=e.message;}};
    const generate=document.getElementById('generate');if(generate)generate.onclick=async()=>{try{
        const r=await fetch(`${root}/FormVersionResponse/rtf-template/generate/${version}`,{method:'POST'});
        if(!r.ok)throw Error(await r.text());status.textContent='Šablona vygenerována.';await reload();
    }catch(e){status.textContent=e.message;}};
})();
</script>
@code {
    [Parameter, EditorRequired] public FormVersionResponse Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool MayEdit { get; set; }
}
