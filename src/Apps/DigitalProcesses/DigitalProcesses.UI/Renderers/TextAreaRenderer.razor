@namespace WebAppArchitecture.DigitalProcesses.UI.Renderers

<div id="@($"form-field-{Value?.id ?? Definition.id:N}")" class="mb-3" data-form-node-id="@Definition.id">
    <label class="form-label" for="@InputId">@(Definition.label ?? Definition.key)</label>
    <textarea id="@InputId" name="@($"node-{Definition.id:N}")" class="form-control" rows="4">@RendererValue.AsString(Value)</textarea>
    @if (!string.IsNullOrWhiteSpace(Definition.description))
    {
        <div class="form-text">@Definition.description</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public FormNodeResponse Definition { get; set; } = default!;
    [Parameter] public SubmissionNodeResponse? Value { get; set; }
    private string InputId => $"form-node-{Value?.id ?? Definition.id:N}";
}
