@using WebAppArchitecture.DigitalProcesses.UI.ProcessDefinition.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.ProcessDefinition.Pages

<Page Title="@Model.Title">
    <div class="container py-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h4 mb-1">@Model.Title</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="text-muted">@Model.Description</div>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.ListUrl))
            {
                <a class="btn btn-outline-secondary" href="@Model.ListUrl">Back to list</a>
            }
        </div>
        <ProcessDefinitionCreateCard Model="@Model" />
    </div>
</Page>

@code {
    [Parameter] public DigitalProcessCreatePageModel Model { get; set; } = ProcessDefinitionCreateForm.CreatePage();
    [Parameter] public bool IsFragment { get; set; }
}
