@using WebAppArchitecture.DigitalProcesses.Models.ProcessDefinition
@using WebAppArchitecture.DigitalProcesses.UI.ProcessDefinition.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.ProcessDefinition.Pages

<PageViewList TModel="ProcessDefinitionResponse" Items="@Model" Title="Process definitions" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <ProcessDefinitionMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public ProcessDefinitionResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
