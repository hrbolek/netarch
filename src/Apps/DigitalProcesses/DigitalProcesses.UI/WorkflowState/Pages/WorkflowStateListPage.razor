@using WebAppArchitecture.DigitalProcesses.Models.WorkflowState
@using WebAppArchitecture.DigitalProcesses.UI.WorkflowState.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.WorkflowState.Pages

<PageViewList TModel="WorkflowStateResponse" Items="@Model" Title="Workflow states" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <WorkflowStateMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public WorkflowStateResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
