@using WebAppArchitecture.DigitalProcesses.Models.WorkflowTransition
@namespace WebAppArchitecture.DigitalProcesses.UI.WorkflowTransition.Components
@using System.Text.Json
@using WebAppArchitecture.Base.UI.Components

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Title</span>
        <EntityLink TModel="WorkflowTransitionResponse" Model="@Model" App="digital-processes" />
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted small">id</dt>
            <dd class="col-sm-8 text-break">@(Model.id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">workflow version id</dt>
            <dd class="col-sm-8 text-break">@(Model.workflow_version_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">source state id</dt>
            <dd class="col-sm-8 text-break">@(Model.source_state_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">target state id</dt>
            <dd class="col-sm-8 text-break">@(Model.target_state_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">key</dt>
            <dd class="col-sm-8 text-break">@(Model.key.ToString())</dd>
            <dt class="col-sm-4 text-muted small">name</dt>
            <dd class="col-sm-8 text-break">@(Model.name.ToString())</dd>
            <dt class="col-sm-4 text-muted small">note required</dt>
            <dd class="col-sm-8 text-break">@(Model.note_required.ToString())</dd>
            <dt class="col-sm-4 text-muted small">condition query</dt>
            <dd class="col-sm-8 text-break">@((Model.condition_query?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">action query</dt>
            <dd class="col-sm-8 text-break">@((Model.action_query?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">rbacobject id</dt>
            <dd class="col-sm-8 text-break">@(Model.rbacobject_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created at</dt>
            <dd class="col-sm-8 text-break">@(Model.created_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated at</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created by</dt>
            <dd class="col-sm-8 text-break">@(Model.created_by.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated by</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_by.ToString())</dd>
        </dl>
        <details class="mt-3"><summary class="small text-muted">Raw JSON (diagnostics)</summary><pre class="small mt-2">@JsonSerializer.Serialize(Model, JsonOptions)</pre></details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public WorkflowTransitionResponse Model { get; set; } = default!;
    [Parameter] public string Title { get; set; } = typeof(WorkflowTransitionResponse).Name;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
