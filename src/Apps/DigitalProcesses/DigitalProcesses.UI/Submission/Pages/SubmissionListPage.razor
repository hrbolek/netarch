@using WebAppArchitecture.DigitalProcesses.Models.Submission
@using WebAppArchitecture.DigitalProcesses.UI.Submission.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.Submission.Pages

<PageViewList TModel="SubmissionResponse" Items="@Model" Title="Submissions" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <SubmissionMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public SubmissionResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
