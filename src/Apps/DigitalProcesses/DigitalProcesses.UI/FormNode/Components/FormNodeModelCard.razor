@using WebAppArchitecture.DigitalProcesses.Models.FormNode
@namespace WebAppArchitecture.DigitalProcesses.UI.FormNode.Components
@using System.Text.Json
@using WebAppArchitecture.Base.UI.Components

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Title</span>
        <EntityLink TModel="FormNodeResponse" Model="@Model" App="digital-processes" />
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted small">id</dt>
            <dd class="col-sm-8 text-break">@(Model.id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">form version id</dt>
            <dd class="col-sm-8 text-break">@(Model.form_version_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">parent id</dt>
            <dd class="col-sm-8 text-break">@((Model.parent_id?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">path</dt>
            <dd class="col-sm-8 text-break">@(Model.path.ToString())</dd>
            <dt class="col-sm-4 text-muted small">key</dt>
            <dd class="col-sm-8 text-break">@(Model.key.ToString())</dd>
            <dt class="col-sm-4 text-muted small">label</dt>
            <dd class="col-sm-8 text-break">@((Model.label?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">description</dt>
            <dd class="col-sm-8 text-break">@((Model.description?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">node type id</dt>
            <dd class="col-sm-8 text-break">@(Model.node_type_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">position</dt>
            <dd class="col-sm-8 text-break">@(Model.position.ToString())</dd>
            <dt class="col-sm-4 text-muted small">min occurs</dt>
            <dd class="col-sm-8 text-break">@(Model.min_occurs.ToString())</dd>
            <dt class="col-sm-4 text-muted small">max occurs</dt>
            <dd class="col-sm-8 text-break">@(Model.max_occurs.ToString())</dd>
            <dt class="col-sm-4 text-muted small">own security scope</dt>
            <dd class="col-sm-8 text-break">@(Model.own_security_scope.ToString())</dd>
            <dt class="col-sm-4 text-muted small">configuration json</dt>
            <dd class="col-sm-8 text-break">@((Model.configuration_json?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">rbacobject id</dt>
            <dd class="col-sm-8 text-break">@(Model.rbacobject_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created at</dt>
            <dd class="col-sm-8 text-break">@(Model.created_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated at</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created by</dt>
            <dd class="col-sm-8 text-break">@(Model.created_by.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated by</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_by.ToString())</dd>
        </dl>
        <details class="mt-3"><summary class="small text-muted">Raw JSON (diagnostics)</summary><pre class="small mt-2">@JsonSerializer.Serialize(Model, JsonOptions)</pre></details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public FormNodeResponse Model { get; set; } = default!;
    [Parameter] public string Title { get; set; } = typeof(FormNodeResponse).Name;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
