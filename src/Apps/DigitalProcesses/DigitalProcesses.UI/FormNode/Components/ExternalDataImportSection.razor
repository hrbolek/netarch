@namespace WebAppArchitecture.DigitalProcesses.UI.FormNode.Components

<div class="mb-3" data-external-data-import="true" data-form-node-id="@ActionId">
    @if (CanExecutePreview)
    {
        <button type="button" class="btn @(IsExport ? "btn-outline-success" : "btn-outline-primary")"
                hx-post="@($"/digital-processes/form-preview/actions/{ActionId}")"
                hx-include="#dp-preview-form"
                hx-vals="@IdentityPayload"
                hx-target="closest [data-external-data-import]"
                hx-swap="outerHTML"
                hx-indicator="closest [data-external-data-import]">
            @(ActionLabel ?? (IsExport ? "Export dat" : "Import dat"))
        </button>
        <span class="htmx-indicator small text-muted ms-2">Načítám…</span>
    }
    else
    {
        <button type="button" class="btn btn-outline-secondary" disabled title="Import lze spustit v režimu Test.">@(ActionLabel ?? (IsExport ? "Export dat" : "Import dat"))</button>
    }
</div>

@code {
    [CascadingParameter(Name = "PreviewInstanceId")] public Guid PreviewInstanceId { get; set; }
    [CascadingParameter(Name = "PreviewFormVersionId")] public Guid PreviewFormVersionId { get; set; }
    [Parameter] public bool IsExport { get; set; }
    private bool CanExecutePreview => PreviewInstanceId != Guid.Empty && PreviewFormVersionId != Guid.Empty;
    private string IdentityPayload => System.Text.Json.JsonSerializer.Serialize(new
    {
        previewInstanceId = PreviewInstanceId.ToString("D"),
        formVersionId = PreviewFormVersionId.ToString("D")
    });
    [Parameter] public Guid ActionId { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
}
