@using WebAppArchitecture.DigitalProcesses.Models.FormNode
@namespace WebAppArchitecture.DigitalProcesses.UI.FormNode.Components
<div data-form-tabs>
    <div class="nav nav-tabs mb-3" role="tablist" aria-label="Form sections">
        @for (var index = 0; index < Sections.Count; index++)
        {
            var node = Sections[index];
            <button type="button" class="nav-link @(index == 0 ? "active" : "")" role="tab"
                    id="@($"{Prefix}-tab-{node.id:N}")" aria-controls="@($"{Prefix}-panel-{node.id:N}")"
                    aria-selected="@(index == 0 ? "true" : "false")" tabindex="@(index == 0 ? 0 : -1)"
                    data-section-tab="@node.id">
                @(node.label ?? node.key)
            </button>
        }
    </div>
    @for (var index = 0; index < Sections.Count; index++)
    {
        var node = Sections[index];
        <div role="tabpanel" id="@($"{Prefix}-panel-{node.id:N}")" aria-labelledby="@($"{Prefix}-tab-{node.id:N}")"
             data-section-panel="@node.id" hidden="@(index != 0)">
            @ChildContent(node)
        </div>
    }
</div>
<script src="/_content/DigitalProcesses.UI/digital-processes-sections.js"></script>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FormNodeResponse> Sections { get; set; } = [];
    [Parameter, EditorRequired] public RenderFragment<FormNodeResponse> ChildContent { get; set; } = default!;
    private readonly string Prefix = $"sections-{Guid.NewGuid():N}";
}
