@namespace WebAppArchitecture.DigitalProcesses.UI.WorkflowStateAccessRule.Components

<div class="card shadow-sm">
    <div class="card-header fw-semibold">@Model.Title</div>
    <form method="post" action="@Model.Action" class="card-body">
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "workflow_state_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "source_role_type_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "target_role_type_id")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "target_scope")' />
        <CreateFormField Field='@Model.Fields.Single(field => field.Name == "target_form_node_id")' />
        <div><button type="submit" class="btn btn-primary">@Model.SubmitLabel</button></div>
    </form>
</div>

@code {
    [Parameter, EditorRequired] public DigitalProcessCreatePageModel Model { get; set; } = default!;
}
