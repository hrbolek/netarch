@using WebAppArchitecture.DigitalProcesses.Models.RequestTransitionHistory
@namespace WebAppArchitecture.DigitalProcesses.UI.RequestTransitionHistory.Components
@using System.Text.Json
@using WebAppArchitecture.Base.UI.Components

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Title</span>
        <EntityLink TModel="RequestTransitionHistoryResponse" Model="@Model" App="digital-processes" />
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted small">id</dt>
            <dd class="col-sm-8 text-break">@(Model.id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">request id</dt>
            <dd class="col-sm-8 text-break">@(Model.request_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">transition id</dt>
            <dd class="col-sm-8 text-break">@(Model.transition_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">from state id</dt>
            <dd class="col-sm-8 text-break">@(Model.from_state_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">to state id</dt>
            <dd class="col-sm-8 text-break">@(Model.to_state_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">archived submission id</dt>
            <dd class="col-sm-8 text-break">@(Model.archived_submission_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">actor user id</dt>
            <dd class="col-sm-8 text-break">@(Model.actor_user_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">note</dt>
            <dd class="col-sm-8 text-break">@((Model.note?.ToString() ?? "\u2014"))</dd>
            <dt class="col-sm-4 text-muted small">changed at</dt>
            <dd class="col-sm-8 text-break">@(Model.changed_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">rbacobject id</dt>
            <dd class="col-sm-8 text-break">@(Model.rbacobject_id.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created at</dt>
            <dd class="col-sm-8 text-break">@(Model.created_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated at</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_at.ToString())</dd>
            <dt class="col-sm-4 text-muted small">created by</dt>
            <dd class="col-sm-8 text-break">@(Model.created_by.ToString())</dd>
            <dt class="col-sm-4 text-muted small">updated by</dt>
            <dd class="col-sm-8 text-break">@(Model.updated_by.ToString())</dd>
        </dl>
        <details class="mt-3"><summary class="small text-muted">Raw JSON (diagnostics)</summary><pre class="small mt-2">@JsonSerializer.Serialize(Model, JsonOptions)</pre></details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public RequestTransitionHistoryResponse Model { get; set; } = default!;
    [Parameter] public string Title { get; set; } = typeof(RequestTransitionHistoryResponse).Name;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
