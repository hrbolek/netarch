@using WebAppArchitecture.DigitalProcesses.Models.Request
@using WebAppArchitecture.DigitalProcesses.UI.Request.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.Request.Pages

<Page Title="Request">
    <RequestLargeCard Model="@Model">
        <ChildContent>
            @if (Model.workspace is { } workspace)
            {
                <RequestWorkspace Model="@workspace" />
            }
            else
            {
                <RequestModelCard Model="@Model" />
            }
        </ChildContent>
    </RequestLargeCard>

</Page>

@code {
    [Parameter, EditorRequired] public RequestResponse Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
}
