@using WebAppArchitecture.DigitalProcesses.Models.Request
@using WebAppArchitecture.DigitalProcesses.Models.RequestTransitionHistory
@using WebAppArchitecture.DigitalProcesses.Models.WorkflowState
@using WebAppArchitecture.DigitalProcesses.UI.Submission.Pages
@namespace WebAppArchitecture.DigitalProcesses.UI.Request.Pages

<Page Title="Digital request">
    <div class="container py-3">
        <h1 class="h4"><EntityLink TModel="RequestResponse" Model="@Model.request" App="digital-processes" /></h1>
        <div class="mb-3">
            State: <EntityLink TModel="WorkflowStateResponse" Model="@Model.state" App="digital-processes" />
        </div>
        <SubmissionTreePage Model="@Model.active_submission" IsFragment="true" />
        <h2 class="h5 mt-4">State transition history</h2>
        <div class="list-group">
            @foreach (var item in Model.history)
            {
                <div class="list-group-item">
                    <EntityLink TModel="RequestTransitionHistoryResponse" Model="@item" App="digital-processes" />
                    <span class="ms-2">@item.changed_at.ToString("u")</span>
                    @if (!string.IsNullOrWhiteSpace(item.note))
                    {
                        <div>@item.note</div>
                    }
                </div>
            }
        </div>
    </div>
</Page>

@code {
    [Parameter, EditorRequired] public RequestDetailResponse Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
}
