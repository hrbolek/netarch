@using WebAppArchitecture.DigitalProcesses.Models.FormNode
@using WebAppArchitecture.DigitalProcesses.Models.Request
@using WebAppArchitecture.DigitalProcesses.Models.SubmissionNode
@using WebAppArchitecture.DigitalProcesses.Models.WorkflowTransition
@using WebAppArchitecture.DigitalProcesses.UI.FormNode.Components
@using WebAppArchitecture.DigitalProcesses.UI.SubmissionNode.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.Request.Components

    <div data-request-workspace="@Model.Request.request.id">
        <section class="card mb-4">
            <div class="card-header d-flex justify-content-between">
                <strong>Formulář</strong>
                <span>Stav: <strong>@Model.Request.state.name</strong></span>
            </div>
            <div class="card-body">
                @if (!Roots.Any())
                {
                    <div class="alert alert-warning mb-0">Tato verze formuláře nemá žádná pole.</div>
                }
                else
                {
                    <form id="process-test-form" data-request-id="@Model.Request.request.id">
                        <FormSectionTabs Sections="@Roots.ToArray()" Context="root">
                            <SubmissionFormNode Node="@root" Nodes="@Model.Form.nodes" Types="@Model.Form.node_types"
                                                 Values="@Model.Request.active_submission.nodes" EditableNodeIds="@Model.EditableNodeIds" />
                        </FormSectionTabs>
                    </form>
                    <div id="process-test-save-status" class="small text-muted" role="status"></div>
                }
            </div>
        </section>

        <section class="card mb-4">
            <div class="card-header"><strong>Workflow</strong></div>
            <div class="card-body">
                @if (!Model.MayTransition)
                {
                    <p class="text-muted mb-0">Pro změnu stavu nemáte oprávnění nebo je submission archivovaná.</p>
                }
                else if (!AvailableTransitions.Any())
                {
                    <p class="text-muted mb-0">Pro aktuální stav nejsou definovány žádné přechody.</p>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var transition in AvailableTransitions)
                        {
                            <form data-process-test-transition method="post" action="@($"/digital-processes/RequestResponse/transition-form/{Model.Request.request.id}")"
                                  onsubmit="return this.dataset.ready === '1' || confirm('Provést změnu stavu?');">
                                <input type="hidden" name="transition_id" value="@transition.id" />
                                @if (ReturnToRequest)
                                {
                                    <input type="hidden" name="return_to" value="request" />
                                }
                                <div class="d-flex gap-2 align-items-end">
                                    @if (transition.note_required)
                                    {
                                        <label class="small">
                                            Poznámka
                                            <input class="form-control form-control-sm" name="note" required />
                                        </label>
                                    }
                                    <button type="submit" class="btn btn-primary">@transition.name</button>
                                </div>
                            </form>
                        }
                    </div>
                }
            </div>
        </section>

        <section>
            <h2 class="h5">Historie přechodů</h2>
            @if (!Model.Request.history.Any())
            {
                <p class="text-muted">Zatím žádné přechody.</p>
            }
            else
            {
                <ol class="list-group list-group-numbered">
                    @foreach (var entry in Model.Request.history)
                    {
                        <li class="list-group-item">
                            <strong>@StateName(entry.from_state_id)</strong>
                            <span aria-hidden="true">→</span>
                            <strong>@StateName(entry.to_state_id)</strong>
                            <span class="text-muted ms-2">@entry.changed_at.ToLocalTime().ToString("g")</span>
                            @if (!string.IsNullOrWhiteSpace(entry.note))
                            {
                                <div>@entry.note</div>
                            }
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

<script>
(() => {
  const form = document.getElementById('process-test-form');
  if (!form || form.dataset.bound) return;
  form.dataset.bound = '1';
  form.addEventListener('submit', event => event.preventDefault());
  let timer;
  const status = document.getElementById('process-test-save-status');
  async function save(input) {
    const host = input.closest('[data-submission-node-id]');
    if (!host || input.disabled || input.matches(':disabled')) return true;
    let value;
    if (input.matches('[data-search-value]')) {
      try { value = input.value ? JSON.parse(input.value) : null; }
      catch {
        const fieldStatus = host.querySelector('[data-save-status]');
        fieldStatus.textContent = 'Neplatná vybraná hodnota vyhledávání.';
        return false;
      }
    } else {
      value = input.type === 'checkbox' ? input.checked : input.value;
    }
    const fieldStatus = host.querySelector('[data-save-status]');
    fieldStatus.textContent = 'Ukládám…';
    try {
      const response = await fetch('/digital-processes/SubmissionNodeResponse/value/' + host.dataset.submissionNodeId, {
        method: 'PUT',
        credentials: 'same-origin',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({value_json: JSON.stringify(value)})
      });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      fieldStatus.textContent = 'Uloženo';
      status.textContent = '';
      return true;
    } catch (error) {
      fieldStatus.textContent = 'Chyba ukládání';
      status.textContent = 'Hodnotu se nepodařilo uložit: ' + error.message;
      status.className = 'small text-danger';
      return false;
    }
  }
  form.addEventListener('input', event => {
    if (!event.target.matches('input, textarea, select') || event.target.matches('[data-search-input]')) return;
    clearTimeout(timer);
    timer = setTimeout(() => save(event.target), 350);
  });
  form.addEventListener('change', event => {
    if (!event.target.matches('input, textarea, select') || event.target.matches('[data-search-input]')) return;
    clearTimeout(timer);
    save(event.target);
  });
  document.querySelectorAll('form[data-process-test-transition]').forEach(transitionForm => {
    transitionForm.addEventListener('submit', async event => {
      if (event.defaultPrevented) return;
      if (transitionForm.dataset.ready === '1') return;
      event.preventDefault();
      clearTimeout(timer);
      const inputs = [...form.querySelectorAll('input:not([data-search-input]):not(:disabled), textarea:not(:disabled), select:not(:disabled)')];
      const saved = await Promise.all(inputs.map(save));
      if (saved.some(ok => !ok)) {
        status.textContent = 'Workflow nelze spustit, dokud se nepodaří uložit všechna vyplněná pole.';
        status.className = 'small text-danger';
        return;
      }
      transitionForm.dataset.ready = '1';
      transitionForm.requestSubmit();
    });
  });
})();
</script>

@code {
    [Parameter, EditorRequired] public RequestWorkspaceResponse Model { get; set; } = default!;
    [Parameter] public bool ReturnToRequest { get; set; } = true;

    private IEnumerable<FormNodeResponse> Roots =>
        Model.Form.nodes.Where(x => x.parent_id is null &&
            Model.Request.active_submission.nodes.Any(value => value.form_node_id == x.id && value.parent_id is null))
            .OrderBy(x => x.position).ThenBy(x => x.key);
    private IEnumerable<WorkflowTransitionResponse> AvailableTransitions =>
        Model.Workflow.transitions.Where(x => x.source_state_id == Model.Request.state.id);
    private string StateName(Guid id) =>
        Model.Workflow.states.FirstOrDefault(x => x.id == id)?.name ?? id.ToString();
}
