@using WebAppArchitecture.DigitalProcesses.Models.SubmissionNode
@using WebAppArchitecture.DigitalProcesses.UI.SubmissionNode.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.SubmissionNode.Pages

<PageViewList TModel="SubmissionNodeResponse" Items="@Model" Title="Submission nodes" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <SubmissionNodeMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public SubmissionNodeResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
