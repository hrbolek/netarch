@namespace WebAppArchitecture.DigitalProcesses.UI.Designer

@if (NodeType is not null && Instances.Any())
{
    @if (NodeType.can_have_children && FormSectionLayout.IsTable(Node))
    {
        <section class="card mb-3" data-form-node-id="@Node.id" data-repeat-section="true">
            <div class="card-header"><strong>@(Node.label ?? Node.key)</strong></div>
            @if (!string.IsNullOrWhiteSpace(Node.description))
            {
                <div class="card-body py-2 text-muted small">@Node.description</div>
            }
            <div class="card-body table-responsive" data-section-table>
                <table class="table table-bordered align-middle">
                    <thead><tr>@foreach (var child in TableChildren) { <th scope="col">@(child.label ?? child.key)</th> }</tr></thead>
                    <tbody>
                        @foreach (var instance in Instances)
                        {
                            <tr data-repeat-instance data-occurrence="@instance.occurrence">
                                @foreach (var child in TableChildren)
                                {
                                    var value = Values.FirstOrDefault(x => x.parent_id == instance.id && x.form_node_id == child.id);
                                    <FormTableCell Editable="@(value is not null && IsInput(child))" Label="@(child.label ?? child.key)" ValueJson="@value?.value_json">
                                        <ProcessTestFormNode Node="@child" Nodes="@Nodes" Types="@Types" Values="@Values" ParentInstanceId="@instance.id" />
                                    </FormTableCell>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
    else
    {
    @foreach (var instance in Instances)
    {
        @if (NodeType.can_have_children)
        {
            <section class="card mb-3" data-form-node-id="@Node.id" data-repeat-section="@(Node.max_occurs > 1 ? "true" : "false")">
                <div class="card-header"><strong>@(Node.label ?? Node.key)</strong></div>
                @if (!string.IsNullOrWhiteSpace(Node.description))
                {
                    <div class="card-body py-2 text-muted small">@Node.description</div>
                }
                <div class="card-body" data-repeat-instance data-occurrence="@instance.occurrence">
                    @foreach (var child in Children)
                    {
                        <ProcessTestFormNode Node="@child" Nodes="@Nodes" Types="@Types" Values="@Values"
                                             ParentInstanceId="@instance.id" />
                    }
                </div>
            </section>
        }
        else
        {
            <div data-submission-node-id="@instance.id" class="mb-3">
                <FormNodeRenderer RendererKey="@NodeType.renderer_key" Definition="@Node" Value="@instance"
                                  SectionNodes="@SectionNodes" SectionValues="@SectionValues" FormNodes="@Nodes" />
                <span class="small text-muted" data-save-status aria-live="polite"></span>
            </div>
        }
    }
    }
}

@code {
    [Parameter, EditorRequired] public FormNodeResponse Node { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyCollection<FormNodeResponse> Nodes { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyCollection<FormNodeTypeResponse> Types { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyCollection<SubmissionNodeResponse> Values { get; set; } = [];
    [Parameter] public Guid? ParentInstanceId { get; set; }

    private FormNodeTypeResponse? NodeType => Types.FirstOrDefault(x => x.id == Node.node_type_id);
    private bool IsInput(FormNodeResponse node) => Types.Any(x => x.id == node.node_type_id && x.renderer_key.StartsWith("input.", StringComparison.Ordinal));
    private IEnumerable<FormNodeResponse> Children =>
        Nodes.Where(x => x.parent_id == Node.id).OrderBy(x => x.position).ThenBy(x => x.key);
    private IEnumerable<FormNodeResponse> TableChildren => Children.Where(child =>
        Instances.Any(row => Values.Any(value => value.parent_id == row.id && value.form_node_id == child.id)));
    private IEnumerable<SubmissionNodeResponse> Instances =>
        Values.Where(x => x.form_node_id == Node.id && x.parent_id == ParentInstanceId)
            .OrderBy(x => x.occurrence).ThenBy(x => x.position);
    private IReadOnlyCollection<FormNodeResponse> SectionNodes =>
        Node.parent_id is Guid sectionId ? Nodes.Where(x => x.parent_id == sectionId).ToArray() : Nodes.Where(x => x.parent_id is null).ToArray();
    private IReadOnlyDictionary<string, System.Text.Json.Nodes.JsonNode?> SectionValues
    {
        get
        {
            var definitions = SectionNodes.ToDictionary(x => x.id);
            var parentId = ParentInstanceId;
            return Values.Where(x => x.parent_id == parentId && definitions.ContainsKey(x.form_node_id))
                .Select(x => (Definition: definitions[x.form_node_id], Node: x))
                .Where(x => !string.IsNullOrWhiteSpace(x.Node.value_json))
                .GroupBy(x => x.Definition.key)
                .ToDictionary(x => x.Key, x => ParseValue(x.First().Node.value_json));
        }
    }

    private static System.Text.Json.Nodes.JsonNode? ParseValue(string? json)
    {
        try { return string.IsNullOrWhiteSpace(json) ? null : System.Text.Json.Nodes.JsonNode.Parse(json); }
        catch (System.Text.Json.JsonException) { return System.Text.Json.Nodes.JsonValue.Create(json); }
    }
}
