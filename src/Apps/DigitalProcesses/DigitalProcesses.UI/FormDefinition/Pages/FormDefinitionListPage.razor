@using WebAppArchitecture.DigitalProcesses.Models.FormDefinition
@using WebAppArchitecture.DigitalProcesses.UI.FormDefinition.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.FormDefinition.Pages

<PageViewList TModel="FormDefinitionResponse" Items="@Model" Title="Form definitions" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <FormDefinitionMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public FormDefinitionResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
