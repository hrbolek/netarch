@using WebAppArchitecture.DigitalProcesses.Models.FormDefinition
@using System.Text.Json
@namespace WebAppArchitecture.DigitalProcesses.UI.FormDefinition.Components
<MediumCard TModel="FormDefinitionResponse" Model="@Model" HeaderText="FormDefinition" ActionsUrl="@($"/digital-processes/FormDefinitionResponse/actions/{Model.id}")">
    <ChildContent Context="item">
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="visual label" AttributeValue="@item.visual_label" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="name" AttributeValue="@item.name" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="description" AttributeValue="@item.description" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="id" AttributeValue="@item.id" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="rbacobject id" AttributeValue="@item.rbacobject_id" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="created at" AttributeValue="@item.created_at" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="updated at" AttributeValue="@item.updated_at" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="created by" AttributeValue="@item.created_by" />
        <Attribute TModel="FormDefinitionResponse" Item="@item" Label="updated by" AttributeValue="@item.updated_by" />
        <details class="mt-3">
            <summary class="small text-muted">Raw JSON (diagnostics)</summary>
            <pre class="small mt-2">@JsonSerializer.Serialize(item, JsonOptions)</pre>
        </details>
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired] public FormDefinitionResponse Model { get; set; } = default!;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
