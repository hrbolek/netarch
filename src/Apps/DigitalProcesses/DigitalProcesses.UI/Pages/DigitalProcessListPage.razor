@typeparam TModel where TModel : IEntityDTOModel
@namespace WebAppArchitecture.DigitalProcesses.UI.Pages
@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.DigitalProcesses.UI.Components
@using WebAppArchitecture.DigitalProcesses.Models
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@if (CreateUrl is not null)
{
    <div class="container-fluid pt-3 text-end">
        <a class="btn btn-primary" href="@CreateUrl">Create @ListTitle</a>
    </div>
}
<PageViewList TModel="TModel" Items="@Model" Title="@ListTitle" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <DigitalProcessMediumCard TModel="TModel" Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public TModel[] Model { get; set; } = Array.Empty<TModel>();
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;


    private string ListTitle => typeof(TModel).Name switch
    {
        nameof(FormDefinitionResponse) => "Form definitions",
        nameof(FormVersionResponse) => "Form versions",
        nameof(FormNodeTypeResponse) => "Form node types",
        nameof(FormNodeResponse) => "Form nodes",
        nameof(WorkflowDefinitionResponse) => "Workflow definitions",
        nameof(WorkflowVersionResponse) => "Workflow versions",
        nameof(WorkflowStateResponse) => "Workflow states",
        nameof(WorkflowStateAccessRuleResponse) => "Workflow state access rules",
        nameof(WorkflowTransitionResponse) => "Workflow transitions",
        nameof(ProcessDefinitionResponse) => "Process definitions",
        nameof(ProcessDefinitionVersionResponse) => "Process definition versions",
        nameof(RequestResponse) => "Requests",
        nameof(SubmissionResponse) => "Submissions",
        nameof(SubmissionNodeResponse) => "Submission nodes",
        nameof(RequestTransitionHistoryResponse) => "Request transition history",
        _ => typeof(TModel).Name.EndsWith("Response", StringComparison.Ordinal)
            ? typeof(TModel).Name[..^"Response".Length]
            : typeof(TModel).Name
    };

    private string CurrentWhere => HttpContextAccessor.HttpContext?.Request.Query["where"].ToString() ?? string.Empty;
    private string CurrentPath => HttpContextAccessor.HttpContext?.Request.Path.ToString() ?? string.Empty;

    private string? CreateUrl => typeof(TModel).Name switch
    {
        nameof(FormDefinitionResponse) => "/digital-processes/FormDefinitionResponse/create",
        nameof(FormVersionResponse) => "/digital-processes/FormVersionResponse/create",
        nameof(FormNodeTypeResponse) => "/digital-processes/FormNodeTypeResponse/create",
        nameof(FormNodeResponse) => "/digital-processes/FormNodeResponse/create",
        nameof(WorkflowDefinitionResponse) => "/digital-processes/WorkflowDefinitionResponse/create",
        nameof(WorkflowVersionResponse) => "/digital-processes/WorkflowVersionResponse/create",
        nameof(WorkflowStateResponse) => "/digital-processes/WorkflowStateResponse/create",
        nameof(WorkflowStateAccessRuleResponse) => "/digital-processes/WorkflowStateAccessRuleResponse/create",
        nameof(WorkflowTransitionResponse) => "/digital-processes/WorkflowTransitionResponse/create",
        nameof(ProcessDefinitionResponse) => "/digital-processes/ProcessDefinitionResponse/create",
        nameof(ProcessDefinitionVersionResponse) => "/digital-processes/ProcessDefinitionVersionResponse/create",
        nameof(RequestResponse) => "/digital-processes/RequestResponse/create",
        _ => null
    };
}
