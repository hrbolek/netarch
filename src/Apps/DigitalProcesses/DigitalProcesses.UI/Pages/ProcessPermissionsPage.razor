@namespace WebAppArchitecture.DigitalProcesses.UI.Pages
@using System.Linq
<Page Title="Oprávnění polí procesu">
<DigitalProcessLargeCard TModel="ProcessDefinitionVersionResponse" Model="@Model">
<ChildContent Context="version">
    <h1 class="h4">Oprávnění formuláře podle workflow</h1>
    <p class="text-muted">Matice spravuje explicitní pravidla čtení Applicant v jednotlivých stavech workflow. Deny má přednost před zděděným přístupem.</p>
    <div class="alert alert-info">Oprávnění ostatních rolí se spravují pomocí WorkflowStateAccessRule a RBAC.</div>
    @if (version.is_published)
    {
        <div class="alert alert-warning">Publikovaná verze je pouze pro čtení. Pro změnu vytvořte draft.</div>
    }
    else if (!MayEdit)
    {
        <div class="alert alert-warning">Aktuální uživatel nemá operaci Update nad RBAC objektem verze procesu.</div>
    }
    @if (States.Length == 0)
    {
        <div class="alert alert-warning">Žádné čitelné stavy workflow. Vytvořte stavy nebo zkontrolujte oprávnění Read.</div>
    }
    @if (Nodes.Length == 0)
    {
        <div class="alert alert-warning">Žádné čitelné uzly formuláře. Vytvořte uzly nebo zkontrolujte oprávnění Read.</div>
    }
    <div class="table-responsive"><table class="table table-sm table-bordered align-middle">
        <thead><tr><th>FormNode</th>@foreach (var state in States) { <th>@state.name</th> }</tr></thead>
        <tbody>
        @foreach (var node in OrderedNodes)
        {
            <tr>
                <th style="padding-left:@(Math.Clamp(node.path.Count(c => c == '/'), 0, 8) * 16 + 8)px">@node.label <small class="text-muted">(@node.key)</small></th>
                @foreach (var state in States)
                {
                    <td><select class="form-select form-select-sm policy" data-state="@state.id" data-node="@node.id" disabled="@(!MayEdit)">
                        <option value="">Dědit / neurčeno</option>
                        <option value="true">Read</option>
                        <option value="false">Deny</option>
                    </select></td>
                }
            </tr>
        }
        </tbody>
    </table></div>
    <p id="status" role="status" class="small text-muted"></p>
    <p class="small text-muted">Odstranění explicitního pravidla (návrat k dědění) zatím API nepodporuje.</p>
</ChildContent>
</DigitalProcessLargeCard>
</Page>
<script>
(() => {
    const base='/digital-processes/ProcessDefinitionVersionResponse/applicant-access/@Model.id';
    const cells=[...document.querySelectorAll('select.policy')], status=document.getElementById('status');
    fetch(base,{headers:{Accept:'application/json'}}).then(r=>{if(!r.ok)throw Error('HTTP '+r.status);return r.json()}).then(rows=>{
        for(const item of rows){const c=cells.find(x=>x.dataset.state===item.workflow_state_id&&x.dataset.node===item.form_node_id);
            if(c)c.value=String(item.can_read).toLowerCase();}
    }).catch(e=>status.textContent='Načtení pravidel: '+e.message);
    for(const cell of cells)cell.addEventListener('change',async()=>{
        if(cell.value===''){status.textContent='Návrat k dědění zatím není podporován. Použijte API až po implementaci DELETE.';return;}
        cell.disabled=true;
        try{const r=await fetch(base,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify({stateId:cell.dataset.state,formNodeId:cell.dataset.node,canRead:cell.value==='true'})});
            if(!r.ok)throw Error('HTTP '+r.status+' '+await r.text());status.textContent='Pravidlo uloženo.';
        }catch(e){status.textContent='Uložení selhalo: '+e.message;}finally{cell.disabled=false;}
    });
})();
</script>
@code {
    [Parameter, EditorRequired] public ProcessDefinitionVersionResponse Model { get; set; } = default!;
    [Parameter] public bool MayEdit { get; set; }
    [Parameter] public WorkflowStateResponse[] States { get; set; } = [];
    [Parameter] public FormNodeResponse[] Nodes { get; set; } = [];
    private IEnumerable<FormNodeResponse> OrderedNodes => OrderNodes(Nodes);
    private static IEnumerable<FormNodeResponse> OrderNodes(FormNodeResponse[] nodes)
    {
        var seen = new HashSet<Guid>();
        IEnumerable<FormNodeResponse> Visit(Guid? parent)
        {
            var children = nodes.Where(n => n.parent_id == parent).OrderBy(n => n.position).ThenBy(n => n.key);
            foreach (var child in children)
            {
                if (!seen.Add(child.id)) continue;
                yield return child;
                foreach (var descendant in Visit(child.id)) yield return descendant;
            }
        }
        foreach (var root in Visit(null)) yield return root;
        foreach (var orphan in nodes.Where(n => !seen.Contains(n.id)).OrderBy(n => n.position).ThenBy(n => n.key)) yield return orphan;
    }
}
