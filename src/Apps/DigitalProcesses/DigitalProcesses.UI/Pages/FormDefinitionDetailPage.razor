@namespace WebAppArchitecture.DigitalProcesses.UI.Pages

<Page Title="Form definition">
<div class="container py-3">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">@Model.definition.visual_label</h1>
            @if (!string.IsNullOrWhiteSpace(Model.definition.description))
            {
                <div class="text-muted">@Model.definition.description</div>
            }
        </div>
        <a class="btn btn-outline-secondary" href="/digital-processes/FormDefinitionResponse/list">Back to forms</a>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Versions</strong>
            <form method="post" action="/digital-processes/FormDefinitionResponse/new-version/@Model.definition.id"><button type="submit" class="btn btn-sm btn-primary">Copy to new draft</button></form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Version</th><th>Status</th><th>Updated</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var version in Model.versions.OrderByDescending(x => x.version))
                {
                    <tr>
                        <td><a href="/digital-processes/FormVersionResponse/view/@version.id">Version @version.version</a></td>
                        <td>
                            @if (version.is_published)
                            {
                                <span class="badge text-bg-success">Published</span>
                            }
                            else
                            {
                                <span class="badge text-bg-warning">Draft</span>
                            }
                        </td>
                        <td>@version.updated_at.ToString("u")</td>
                        <td class="text-end">
                            @if (!version.is_published)
                            {
                                <a class="btn btn-sm btn-primary" href="/digital-processes/FormVersionResponse/designer/@version.id">Designer</a>
                            }
                            <a class="btn btn-sm btn-outline-primary" href="/digital-processes/FormVersionResponse/test/@version.id">Test</a>
                            @if (!version.is_published) { <form method="post" class="d-inline" action="/digital-processes/FormDefinitionResponse/publish-version/@version.id?definitionId=@Model.definition.id"><button type="submit" class="btn btn-sm btn-success">Publish</button></form> } 
                            @if (!version.is_published) { <form method="post" class="d-inline" action="/digital-processes/FormDefinitionResponse/delete-version/@version.id?definitionId=@Model.definition.id" onsubmit="return confirm('Delete this draft version and all its nodes?');"><button type="submit" class="btn btn-sm btn-outline-danger">Delete draft</button></form> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
</Page>

@code {
    [Parameter, EditorRequired] public FormDefinitionDetailResponse Model { get; set; } = default!;
    [Parameter] public bool IsFragment { get; set; }
}
