@using WebAppArchitecture.DigitalProcesses.Models.WorkflowDefinition
@using WebAppArchitecture.DigitalProcesses.UI.WorkflowDefinition.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.WorkflowDefinition.Pages

<PageViewList TModel="WorkflowDefinitionResponse" Items="@Model" Title="Workflow definitions" ShowFilter="@ShowFilter">
    <ChildContent Context="item">
        <WorkflowDefinitionMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired] public WorkflowDefinitionResponse[] Model { get; set; } = [];
    [Parameter] public bool IsFragment { get; set; }
    [Parameter] public bool ShowFilter { get; set; } = true;
}
