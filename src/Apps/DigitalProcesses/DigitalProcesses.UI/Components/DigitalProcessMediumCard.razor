@typeparam TModel where TModel : IEntityDTOModel
@using System.Reflection
@using WebAppArchitecture.Base.UI.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.Components
<MediumCard TModel="TModel" Model="@Model" HeaderText="@Heading" ActionsUrl="@($"/digital-processes/{typeof(TModel).Name}/actions/{Model.id}")">
    <ChildContent Context="item">
        @foreach (var property in DisplayProperties)
        {
            <Attribute TModel="TModel" Item="@item" Label="@property.Name.Replace('_', ' ')" AttributeName="@property.Name" />
        }
    </ChildContent>
</MediumCard>
@code {
    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;
    private string Heading => typeof(TModel).Name.Replace("Response", "");
    private PropertyInfo[] DisplayProperties => typeof(TModel).GetProperties()
        .Where(p => p.Name is "id" or "name" or "visual_label" or "subject" or "description" or "key" or "label" or "version" or "is_published" or "current_state_id")
        .OrderBy(p => p.Name == "visual_label" ? 0 : p.Name == "name" ? 1 : p.Name == "subject" ? 2 : p.Name == "id" ? 10 : 3)
        .ToArray();
}
