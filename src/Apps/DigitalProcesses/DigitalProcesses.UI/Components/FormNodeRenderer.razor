@using WebAppArchitecture.DigitalProcesses.UI.Routing
@inject IFormNodeRendererRegistry Renderers

@if (ComponentType is not null)
{
    <DynamicComponent Type="@ComponentType" Parameters="@Parameters" />
}
else
{
    <div class="alert alert-warning py-2">
        No renderer is registered for <code>@RendererKey</code>.
    </div>
}

@code {
    [Parameter, EditorRequired] public string RendererKey { get; set; } = default!;
    [Parameter, EditorRequired] public FormNodeResponse Definition { get; set; } = default!;
    [Parameter] public SubmissionNodeResponse? Value { get; set; }
    [Parameter] public IReadOnlyCollection<FormNodeResponse> SectionNodes { get; set; } = Array.Empty<FormNodeResponse>();
    [Parameter] public IReadOnlyDictionary<string, System.Text.Json.Nodes.JsonNode?> SectionValues { get; set; }
        = new Dictionary<string, System.Text.Json.Nodes.JsonNode?>();
    [Parameter] public IReadOnlyCollection<FormNodeResponse> FormNodes { get; set; } = Array.Empty<FormNodeResponse>();
    private Type? ComponentType => Renderers.Resolve(RendererKey);
    private IDictionary<string,object?> Parameters
    {
        get
        {
            var parameters = new Dictionary<string,object?>
            {
                ["Definition"] = Definition,
                ["Value"] = Value
            };
            if (RendererKey is "input.select" or "display.url")
            {
                parameters["SectionNodes"] = SectionNodes;
                if (RendererKey == "display.url") parameters["FormNodes"] = FormNodes;
                parameters["SectionValues"] = SectionValues;
            }
            return parameters;
        }
    }
}
