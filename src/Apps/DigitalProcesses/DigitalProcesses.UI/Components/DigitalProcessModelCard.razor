@typeparam TModel where TModel : IEntityDTOModel
@using System.Text.Json
@using System.Reflection
@using WebAppArchitecture.Base.UI.Components

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>@Title</span>
        <EntityLink TModel="TModel" Model="@Model" App="digital-processes" />
    </div>
    <div class="card-body">
        @if (Model is FormVersionResponse formVersion)
        {
            <div class="d-flex gap-2 mb-3">
                <a class="btn btn-sm btn-primary" href="/digital-processes/FormVersionResponse/designer/@formVersion.id">Designer</a>
                <a class="btn btn-sm btn-outline-primary" href="/digital-processes/FormVersionResponse/test/@formVersion.id">Test</a>
            </div>
        }
        @if (Model is WorkflowVersionResponse workflowVersion)
        {
            <div class="d-flex gap-2 mb-3">
                <a class="btn btn-sm btn-primary" href="/digital-processes/WorkflowVersionResponse/designer/@workflowVersion.id">Workflow editor</a>
            </div>
        }
        <dl class="row mb-0">
            @foreach (var property in typeof(TModel).GetProperties(BindingFlags.Public | BindingFlags.Instance).Where(p => p.Name != "visual_label"))
            {
                <dt class="col-sm-4 text-muted small">@property.Name.Replace('_', ' ')</dt>
                <dd class="col-sm-8 text-break">@(property.GetValue(Model)?.ToString() ?? "—")</dd>
            }
        </dl>
        <details class="mt-3"><summary class="small text-muted">Raw JSON (diagnostics)</summary><pre class="small mt-2">@JsonSerializer.Serialize(Model, JsonOptions)</pre></details>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;
    [Parameter] public string Title { get; set; } = typeof(TModel).Name;
    private static readonly JsonSerializerOptions JsonOptions = new() { WriteIndented = true };
}
