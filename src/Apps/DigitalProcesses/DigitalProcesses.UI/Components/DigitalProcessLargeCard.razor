@typeparam TModel where TModel : IEntityDTOModel
@using WebAppArchitecture.Base.UI.Components
@namespace WebAppArchitecture.DigitalProcesses.UI.Components
<LargeCard TModel="TModel" Model="@Model" HeaderText="@Heading">
    <SideContent Context="item">
        <DigitalProcessMediumCard TModel="TModel" Model="@item" />
        <EntityLinks TModel="TModel" Model="@item" Links="@GetLinks(item)" />
        <EntityPermissions RbacId="@GetRbacId(item)" />
    </SideContent>
    <ChildContent Context="item">
        @if (ChildContent is not null) { @ChildContent(item) }
        else { <DigitalProcessModelCard TModel="TModel" Model="@item" /> }
    </ChildContent>
</LargeCard>
@code {
    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;
    [Parameter] public RenderFragment<TModel>? ChildContent { get; set; }
    private static string Heading => typeof(TModel).Name.Replace("Response", "");
    private static Guid GetRbacId(TModel item) =>
        (Guid?)typeof(TModel).GetProperty("rbacobject_id")?.GetValue(item) ?? Guid.Empty;
    private static EntityNavigationLink[] GetLinks(TModel item) => item switch
    {
        FormDefinitionResponse form => [new("Versions", $"/digital-processes/FormDefinitionResponse/view/{form.id}", "Form versions and publishing")],
        FormVersionResponse version => [
            new("Designer", $"/digital-processes/FormVersionResponse/designer/{version.id}", "Edit form nodes"),
            new("Test", $"/digital-processes/FormVersionResponse/test/{version.id}", "Try the form"),
            new("RTF templates", $"/digital-processes/form-versions/{version.id}/templates", "Manage document templates")],
        WorkflowDefinitionResponse workflow => [new("Versions", $"/digital-processes/WorkflowDefinitionResponse/view/{workflow.id}", "Workflow versions and editing")],
        WorkflowVersionResponse version => [new("Workflow designer", $"/digital-processes/WorkflowVersionResponse/designer/{version.id}", "States, transitions and simulation")],
        ProcessDefinitionResponse process => [new("Versions", $"/digital-processes/ProcessDefinitionResponse/view/{process.id}", "Process versions and publishing")],
        ProcessDefinitionVersionResponse version => [new("Form permissions", $"/digital-processes/process-versions/{version.id}/permissions", "Applicant deny rules by workflow state and FormNode")],
        _ => []
    };
}
