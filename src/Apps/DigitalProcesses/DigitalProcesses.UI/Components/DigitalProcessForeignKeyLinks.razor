@typeparam TModel where TModel : IEntityDTOModel
@namespace WebAppArchitecture.DigitalProcesses.UI.Components

@* Only real domain foreign keys with a known view endpoint are navigable.
   Audit fields and RBAC identifiers are deliberately excluded. *@
@if (Links.Count > 0)
{
    <div class="border-top pt-2 mt-2" aria-label="Related entities">
        <div class="small text-muted mb-1">Related entities</div>
        @foreach (var link in Links)
        {
            <div class="d-flex justify-content-between gap-2 py-1">
                <span class="text-muted">@link.Label</span>
                <EntityLink TModel="EntityLinkResponse"
                            Model="@(new EntityLinkResponse(link.Id, link.Id.ToString(), link.Entity, "digital-processes", "view"))"
                            App="digital-processes"
                            Entity="@link.Entity"
                            Operation="view"
                            CssClass="text-break">
                    <ChildContent Context="target">@target.visual_label</ChildContent>
                </EntityLink>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public TModel Model { get; set; } = default!;

    private sealed record Relation(string Label, string Entity, Guid Id);

    private IReadOnlyList<Relation> Links => GetLinks(Model);

    private static IReadOnlyList<Relation> GetLinks(TModel item)
    {
        var links = new List<Relation>();
        void Add(string label, string entity, Guid id)
        {
            if (id != Guid.Empty) links.Add(new Relation(label, entity, id));
        }
        switch (item)
        {
            case ProcessDefinitionResponse process:
                if (process.form_definition_id is Guid form) Add("Form definition", nameof(FormDefinitionResponse), form);
                if (process.workflow_definition_id is Guid workflow) Add("Workflow definition", nameof(WorkflowDefinitionResponse), workflow);
                break;
            case FormVersionResponse version:
                Add("Form definition", nameof(FormDefinitionResponse), version.form_definition_id);
                break;
            case WorkflowVersionResponse version:
                Add("Workflow definition", nameof(WorkflowDefinitionResponse), version.workflow_definition_id);
                break;
            case ProcessDefinitionVersionResponse version:
                Add("Process definition", nameof(ProcessDefinitionResponse), version.process_definition_id);
                Add("Form version", nameof(FormVersionResponse), version.form_version_id);
                Add("Workflow version", nameof(WorkflowVersionResponse), version.workflow_version_id);
                break;
            case FormNodeResponse node:
                Add("Form version", nameof(FormVersionResponse), node.form_version_id);
                if (node.parent_id is Guid parent) Add("Parent node", nameof(FormNodeResponse), parent);
                break;
            case WorkflowStateResponse state:
                Add("Workflow version", nameof(WorkflowVersionResponse), state.workflow_version_id);
                break;
            case WorkflowTransitionResponse transition:
                Add("Workflow version", nameof(WorkflowVersionResponse), transition.workflow_version_id);
                Add("Source state", nameof(WorkflowStateResponse), transition.source_state_id);
                Add("Target state", nameof(WorkflowStateResponse), transition.target_state_id);
                break;
            case RequestResponse request:
                Add("Process version", nameof(ProcessDefinitionVersionResponse), request.process_definition_version_id);
                Add("Current state", nameof(WorkflowStateResponse), request.current_state_id);
                Add("Current submission", nameof(SubmissionResponse), request.current_submission_id);
                break;
            case SubmissionResponse submission:
                Add("Request", nameof(RequestResponse), submission.request_id);
                Add("Form version", nameof(FormVersionResponse), submission.form_version_id);
                break;
        }
        return links;
    }
}
