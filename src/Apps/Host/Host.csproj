<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebAppArchitecture.Host</RootNamespace>
    <RazorLangVersion>8.0</RazorLangVersion>
  </PropertyGroup>

  <!-- Build-time host choice; defaults to UI for existing users and integration tests. -->
  <!-- dotnet build src/Apps/Host/Host.csproj -p:ArchitectureApiOnly=true -->
  <PropertyGroup>
    <ArchitectureApiOnly Condition="'$(ArchitectureApiOnly)' == ''">false</ArchitectureApiOnly>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ArchitectureApiOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);ARCHITECTURE_API_ONLY</DefineConstants>
  </PropertyGroup>

  <!-- Development-only optional app. Release has no compilation or reference to it. -->
  <PropertyGroup>
    <EnableJsonataPlayground Condition="'$(EnableJsonataPlayground)' == '' and '$(Configuration)' == 'Debug'">true</EnableJsonataPlayground>
    <EnableJsonataPlayground Condition="'$(EnableJsonataPlayground)' == ''">false</EnableJsonataPlayground>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableJsonataPlayground)' == 'true'">
    <DefineConstants>$(DefineConstants);JSONATA_PLAYGROUND</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Core/Hosting/Core.Hosting.csproj" />
    <ProjectReference Include="../AppComposition/AppComposition.csproj" />
    <ProjectReference Include="../HostManagement/HostManagement.csproj" />
    <ProjectReference Include="../DigitalProcesses/DigitalProcesses.Module/DigitalProcesses.Module.csproj" />
    <ProjectReference Include="../Events/Events.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableJsonataPlayground)' == 'true'">
    <ProjectReference Include="../JsonataPlayground/JsonataPlayground.csproj" />
  </ItemGroup>
</Project>
