{
  "DigitalProcesses": {
    "DataBackend": {
      "Provider": "GraphQL",
      "Endpoint": "http://serverjsonata:3000/graphql",
      "ForwardHeaders": [
        "cookie",
        "authorization",
        "accept-language",
        "x-request-id",
        "x-ms-client-principal",
        "x-ms-client-principal-id",
        "x-ms-client-principal-name"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WebAppArchitecture.DigitalProcesses": "Information",
      "DigitalProcesses.FormPreview.Import": "Trace",
      "WebAppArchitecture.DigitalProcesses.Services.GraphqlLikeFormDataBackend": "Trace"
    }
  },
  "AiAgents": {
    "formdesign_aiagent": {
      "enabled": true,
      "endpoint": "http://host.docker.internal:9088/agents/form-design",
      "timeout_seconds": 180,
      "contract": "form-design.v1"
    },
    "fillform_aiagent": {
      "enabled": false,
      "endpoint": "http://host.docker.internal:9088/agents/fill-form",
      "timeout_seconds": 180,
      "contract": "fill-form.v1"
    },
    "documenttemplate_aiagent": {
      "enabled": false,
      "endpoint": "http://host.docker.internal:9088/agents/document-template",
      "timeout_seconds": 180,
      "contract": "document-template.v1"
    }
  }
}
