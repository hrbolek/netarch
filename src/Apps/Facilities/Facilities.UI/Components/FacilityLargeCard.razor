@namespace WebAppArchitecture.Facilities

<LargeCard TModel="FacilityResponse" Model="@Model" HeaderText="Facility">
    <SideContent Context="item">
        <FacilityMediumCard Model="@item" />
        <EntityPermissions RbacId="@item.rbacobject_id" App="facilities" />
    </SideContent>
    <ChildContent Context="item">
        <Attribute TModel="FacilityResponse" Item="@item" Label="Code" AttributeName="Code" />
        <Attribute TModel="FacilityResponse" Item="@item" Label="Capacity" AttributeName="Capacity" />
        <Attribute TModel="FacilityResponse" Item="@item" Label="Description" AttributeName="Description" />
        <Attribute TModel="FacilityResponse" Item="@item" Label="Parent" AttributeName="ParentId" />
        <Attribute TModel="FacilityResponse" Item="@item" Label="Tree path" AttributeName="path" />
        @if (ChildContent is not null)
        {
            @ChildContent(item)
        }
    </ChildContent>
</LargeCard>

@code {
    [Parameter, EditorRequired] public FacilityResponse Model { get; set; } = default!;
    [Parameter] public RenderFragment<FacilityResponse>? ChildContent { get; set; }
}
