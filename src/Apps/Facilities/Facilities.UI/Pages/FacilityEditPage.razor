@namespace WebAppArchitecture.Facilities

<PageEdit TModel="FacilityResponse" Model="@Model" Title="Edit facility">
    <ChildContent Context="facility">
        <div class="container py-3">
            <h1 class="h3">Edit facility</h1>
            <form id="facility-edit" class="card card-body mb-4">
                <div class="mb-3">
                    <label class="form-label" for="facility-edit-code">Code</label>
                    <input id="facility-edit-code" class="form-control" required value="@facility.Code" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="facility-edit-name">Name</label>
                    <input id="facility-edit-name" class="form-control" maxlength="200" required value="@facility.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="facility-edit-type">Facility type</label>
                    <EntityLookupSelect Name="facilityTypeId" Label="Facility type" ListUrl="/facilities/FacilityTypeResponse/list" SearchFields="@TypeSearchFields" MinChars="2" Take="30" InitialId="@facility.FacilityTypeId" InitialLabel="@FacilityTypeLabel" />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="facility-edit-description">Description</label>
                    <textarea id="facility-edit-description" class="form-control" rows="3">@facility.Description</textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="facility-edit-capacity">Capacity (optional)</label>
                    <input id="facility-edit-capacity" class="form-control" type="number" min="0" step="1" value="@facility.Capacity" />
                </div>
                <div class="form-check mb-3">
                    <input id="facility-edit-active" class="form-check-input" type="checkbox" checked="@facility.IsActive" />
                    <label class="form-check-label" for="facility-edit-active">Active</label>
                </div>
                <div id="facility-edit-error" class="alert alert-danger d-none" role="alert"></div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Save changes</button>
                    <a class="btn btn-outline-secondary" href="@($"/facilities/FacilityResponse/detail/{facility.id}")">Cancel</a>
                </div>
            </form>
            <section id="facility-move" class="mb-4">
                <h2 class="h5">Move facility</h2>
                <p class="text-muted">Choose a destination facility. Permissions are copied into new groups beneath its owned group; the source groups remain unchanged.</p>
                <form id="facility-move-form" class="card card-body">
                    <div class="mb-3">
                        <EntityLookupSelect Name="parentId" Label="Destination facility" ListUrl="/facilities/FacilityResponse/list" SearchFields="@FacilitySearchFields" MinChars="2" Take="30" />
                    </div>
                    <div id="facility-move-error" class="alert alert-danger d-none" role="alert"></div>
                    <div><button class="btn btn-outline-primary" type="submit">Move facility</button></div>
                </form>
            </section>
        </div>
        <script>
            (() => {
                const editForm = document.getElementById('facility-edit');
                if (editForm && !editForm.dataset.bound) {
                    editForm.dataset.bound = '1';
                    editForm.addEventListener('submit', async event => {
                        event.preventDefault();
                        const error = document.getElementById('facility-edit-error');
                        error.classList.add('d-none');
                        const payload = {
                            id: '@facility.id',
                            updated_at: '@facility.updated_at.ToString("O")',
                            code: document.getElementById('facility-edit-code').value,
                            name: document.getElementById('facility-edit-name').value,
                            description: document.getElementById('facility-edit-description').value || null,
                            facilityTypeId: document.querySelector('[name="facilityTypeId"]')?.value,
                            isActive: document.getElementById('facility-edit-active').checked,
                            capacity: document.getElementById('facility-edit-capacity').value === ''
                                ? null
                                : Number(document.getElementById('facility-edit-capacity').value)
                        };
                        try {
                            const response = await fetch('/facilities/FacilityResponse/update', {
                                method: 'PUT',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                credentials: 'same-origin',
                                body: JSON.stringify(payload)
                            });
                            if (!response.ok) throw new Error(`Saving failed (HTTP ${response.status}).`);
                            window.location.assign(`/facilities/FacilityResponse/detail/${payload.id}`);
                        } catch (exception) {
                            error.textContent = exception.message;
                            error.classList.remove('d-none');
                        }
                    });
                }
                const moveForm = document.getElementById('facility-move-form');
                if (moveForm && !moveForm.dataset.bound) {
                    moveForm.dataset.bound = '1';
                    moveForm.addEventListener('submit', async event => {
                        event.preventDefault();
                        const error = document.getElementById('facility-move-error');
                        error.classList.add('d-none');
                        const payload = {
                            parentId: document.querySelector('[name="parentId"]')?.value || null,
                            updated_at: '@facility.updated_at.ToString("O")'
                        };
                        if (!payload.parentId) {
                            error.textContent = 'Choose a destination facility.';
                            error.classList.remove('d-none');
                            return;
                        }
                        try {
                            const response = await fetch('/facilities/FacilityResponse/move/@facility.id', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                credentials: 'same-origin',
                                body: JSON.stringify(payload)
                            });
                            if (!response.ok) throw new Error(`Moving failed (HTTP ${response.status}).`);
                            window.location.assign('/facilities/FacilityResponse/detail/@facility.id');
                        } catch (exception) {
                            error.textContent = exception.message;
                            error.classList.remove('d-none');
                        }
                    });
                }
            })();
        </script>
    </ChildContent>
</PageEdit>

@code {
    [Parameter, EditorRequired] public FacilityResponse Model { get; set; } = default!;
    [Parameter] public IReadOnlyCollection<FacilityTypeResponse> Types { get; set; } = Array.Empty<FacilityTypeResponse>();
    [Parameter] public bool IsFragment { get; set; }

    private static readonly string[] TypeSearchFields = ["name", "code"];
    private static readonly string[] FacilitySearchFields = ["name"];
    private string? FacilityTypeLabel => Types.FirstOrDefault(item => item.id == Model.FacilityTypeId)?.Name;
}
