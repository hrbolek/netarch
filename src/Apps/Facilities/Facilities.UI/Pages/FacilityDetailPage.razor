@namespace WebAppArchitecture.Facilities

<PageView TModel="FacilityResponse" TComponent="FacilityLargeCard" Model="@Model" Title="Facility details">
    <ChildContent Context="item">
        <FacilityLargeCard Model="@item">
            <ChildContent Context="facility">
                <div class="container py-3">
                    <div class="d-flex gap-2 mb-3">
                        <a class="btn btn-primary" href="@($"/facilities/FacilityResponse/edit/{facility.id}")">Edit facility</a>
                        <a class="btn btn-outline-secondary" href="@($"/facilities/FacilityResponse/edit/{facility.id}#facility-move")">Move facility</a>
                        <a class="btn btn-outline-primary" href="@($"/facilities/FacilityReservationResponse/by-facility/{facility.id}")">Reservations</a>
                        <a class="btn btn-outline-secondary" href="@($"/facilities/FacilityResponse/new?parentId={facility.id}")">Add child facility</a>
                    </div>
                    <h2 class="h5">Child facilities</h2>
                    <ViewVector TModel="FacilityResponse" TComponent="FacilityMediumCard" Items="@Children" EmptyText="No child facilities." />
                    <h2 class="h5 mt-4">Reservations</h2>
                    <ViewVector TModel="ReservationResponse" TComponent="ReservationMediumCard" Items="@Reservations" EmptyText="No reservations." />
                </div>
            </ChildContent>
        </FacilityLargeCard>
    </ChildContent>
</PageView>

@code {
    [Parameter, EditorRequired] public FacilityResponse Model { get; set; } = default!;
    [Parameter] public IReadOnlyCollection<FacilityResponse> Children { get; set; } = Array.Empty<FacilityResponse>();
    [Parameter] public IReadOnlyCollection<ReservationResponse> Reservations { get; set; } = Array.Empty<ReservationResponse>();
    [Parameter] public bool IsFragment { get; set; }
}
