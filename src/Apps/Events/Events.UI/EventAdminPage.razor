@namespace WebAppArchitecture.Events
@using Microsoft.AspNetCore.Components
@using WebAppArchitecture.Base.UI.Pages
<Page Title="Správa událostí">
<div class="container py-4">
 
 <nav class="mb-3"><a href="/events/EventResponse/list">← Události</a></nav>
 <h1 class="h3">Správa událostí</h1>
 <p class="text-muted">Načtení standardních typů akademického harmonogramu z původního HTML prototypu. Import doplní pouze chybějící záznamy, existující neupravuje.</p>
 <div class="card mb-3"><div class="card-body">
  <h2 class="h5">Vložit standardní typy</h2>
  @if(Model.Scopes.Count == 0)
  {
   <div class="alert alert-warning">Nemáte oprávnění <code>create</code> v žádném dostupném RBAC rozsahu.</div>
  }
  else
  {
   <form id="events-standard-import" class="d-flex flex-wrap gap-2 align-items-end">
    <div><label class="form-label" for="events-import-scope">RBAC rozsah pro nové typy</label>
     <select id="events-import-scope" class="form-select" required><option value="">Zvolte rozsah</option>
     @foreach(var scope in Model.Scopes){<option value="@scope.Id">@scope.Name</option>}
     </select>
    </div>
    <button class="btn btn-primary" type="submit">Vložit standardní typy</button>
   </form>
   <div id="events-import-result" class="mt-3" role="status" aria-live="polite"></div>
  }
 </div></div>
 <div class="card mb-3"><div class="card-body">
  <h2 class="h5">Import událostí z JSON</h2>
  <p>Podporuje soubor <code>systemdata.hk2026.json</code> s kořenovým polem <code>events</code>. Zachovává ID a vazby nadřazených událostí; existující události nepřepisuje. Chybějící typy z pole <code>eventtypes</code> automaticky doplní se zachováním UUID.</p>
  @if(Model.Scopes.Count > 0)
  {
   <form id="events-json-import" class="d-flex flex-wrap gap-2 align-items-end" enctype="multipart/form-data">
    <div><label for="events-json-file" class="form-label">Soubor JSON</label><input id="events-json-file" class="form-control" type="file" name="file" accept=".json,application/json" required /></div>
    <div><label for="events-json-scope" class="form-label">RBAC rozsah importovaných událostí</label>
     <select id="events-json-scope" class="form-select" required><option value="">Zvolte rozsah</option>
     @foreach(var scope in Model.Scopes){<option value="@scope.Id">@scope.Name</option>}
     </select></div>
    <button class="btn btn-primary" type="submit">Importovat události</button>
   </form>
   <div id="events-json-result" class="mt-3" role="status" aria-live="polite"></div>
  }
  <p class="small text-muted mt-3">Velikost max. 100 MB. Při importu se ignorují ostatní datové sekce a neznámé vazby mimo doménu Events. Časové údaje bez časového pásma se interpretují jako Europe/Prague; nejednoznačné časy se přeskočí.</p>
 </div></div>
 <h2 class="h5">Standardní typy (@StandardEventTypes.All.Count)</h2>
 <div class="table-responsive"><table class="table table-striped table-sm align-middle">
  <thead><tr><th>Barva</th><th>Název</th><th>Zkratka</th><th>UUID</th><th>Stav mezi přístupnými typy</th></tr></thead><tbody>
  @foreach(var t in StandardEventTypes.All)
  {
   <tr><td><span style="display:inline-block;width:28px;height:18px;border:1px solid #777;background-color:@t.Color"></span></td>
    <td>@t.Name</td><td>@t.Abbreviation</td><td><code>@t.Id</code></td>
    <td>@(Model.Types.Any(x => x.id == t.Id || x.Code == t.Code) ? "Existuje" : "Nezobrazen / chybí")</td></tr>
  }
  </tbody></table></div>
</div>
<script>
(()=>{const form=document.getElementById('events-standard-import');if(!form||form.dataset.bound)return;form.dataset.bound='1';
form.addEventListener('submit',async e=>{e.preventDefault();const result=document.getElementById('events-import-result');
result.className='mt-3';result.textContent='Provádím kontrolu typů…';
try{const r=await fetch('/events/EventTypeResponse/import-standard',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({rbacObjectId:document.getElementById('events-import-scope').value})});
if(!r.ok)throw new Error('Import nebyl povolen nebo selhal (HTTP '+r.status+').');
const data=await r.json();result.className='alert alert-success mt-3';result.textContent=`Vloženo: ${data.inserted}; již existovalo: ${data.existing}; celkem: ${data.total}.`;
}catch(ex){result.className='alert alert-danger mt-3';result.textContent=ex.message;}
});})();
</script>
<script>
(()=>{const form=document.getElementById('events-json-import');if(!form||form.dataset.bound)return;form.dataset.bound='1';
form.addEventListener('submit',async e=>{e.preventDefault();const output=document.getElementById('events-json-result');
output.className='alert alert-info mt-3';output.textContent='Import probíhá…';
const data=new FormData();data.append('rbacObjectId',document.getElementById('events-json-scope').value);data.append('file',document.getElementById('events-json-file').files[0]);
try{const response=await fetch('/events/EventResponse/import-json',{method:'POST',credentials:'same-origin',body:data,headers:{'Accept':'application/json'}});
const result=await response.json();if(!response.ok)throw Error(result.error||('HTTP '+response.status));
output.className='alert alert-success mt-3';output.textContent=`Záznamů: ${result.found}; vloženo: ${result.inserted}; vložené typy: ${result.typesInserted}; existovalo: ${result.existing}; chybějící typ: ${result.missingType}; chybějící rodič: ${result.missingParent}; neplatné: ${result.invalid}.`;
if(result.issues?.length){const pre=document.createElement('pre');pre.className='small mt-2 text-wrap';pre.textContent=result.issues.join('\n');output.appendChild(pre);}
}catch(ex){output.className='alert alert-danger mt-3';output.textContent=ex.message;}
});})();
</script>
</Page>
@code {
 [Parameter, EditorRequired] public EventFormsModel Model {get;set;} = new(new(),new(),new());
 [Parameter] public bool IsFragment {get;set;}
}
