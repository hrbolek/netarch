@using WebAppArchitecture.Base.UI.Components
@namespace WebAppArchitecture.Events
@using WebAppArchitecture.Base.UI.Pages
@using Microsoft.AspNetCore.Components
<Page Title="Úprava typu události"><div class="container py-4"><h1 class="h3">Upravit typ události</h1>
<form class="card card-body" id="type-edit"><div class="row mb-3"><div class="col-md-4"><label class="form-label" for="type-code">Kód</label><input id="type-code" class="form-control" required value="@Model.Type.Code" /></div><div class="col-md-8"><label class="form-label" for="type-name">Název</label><input id="type-name" class="form-control" required value="@Model.Type.Name" /></div></div>
<div class="row mb-3"><div class="col-md-6"><label class="form-label" for="type-abbr">Zkratka</label><input id="type-abbr" class="form-control" value="@Model.Type.Abbreviation" /></div><div class="col-md-6"><label class="form-label" for="type-color">Barva</label><input id="type-color" type="color" class="form-control form-control-color" value="@(string.IsNullOrWhiteSpace(Model.Type.Color) ? "#198754" : Model.Type.Color)" /></div></div>
<div class="mb-3"><label class="form-label" for="type-parent">Nadřazený typ</label><EntityLookupSelect Name="parent_id" Label="Nadřazený typ" ListUrl="/events/EventTypeResponse/list" SearchFields="@(new[] { "name", "code" })" MinChars="2" Take="30" Required="false" InitialId="@Model.Type.ParentId" InitialLabel="@(Model.Forms.Types.FirstOrDefault(t => t.id == Model.Type.ParentId)?.Name)" /></div>
<div class="mb-3"><label class="form-label" for="type-mode">Registrace</label><select id="type-mode" class="form-select">@foreach(var mode in new[]{"inherit","disabled","open","approval_required"}){<option value="@mode" selected="@(mode==Model.Type.RegistrationMode)">@mode</option>}</select></div>
<div class="mb-3"><label class="form-label" for="type-description">Popis</label><textarea id="type-description" class="form-control">@Model.Type.Description</textarea></div>
<div id="type-error" class="alert alert-danger d-none"></div><button class="btn btn-primary" type="submit">Uložit změny</button></form>
<script>(()=>{const form=document.getElementById('type-edit');if(!form)return;form.addEventListener('submit',async e=>{e.preventDefault();const v=id=>document.getElementById(id).value;const error=document.getElementById('type-error');error.classList.add('d-none');const payload={code:v('type-code'),name:v('type-name'),abbreviation:v('type-abbr'),color:v('type-color'),parentId:document.querySelector('[name=parent_id]')?.value||null,registrationMode:v('type-mode'),description:v('type-description')};try{const result=await fetch('/events/EventTypeResponse/update/@Model.Type.id',{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!result.ok)throw new Error('Nelze uložit změny (HTTP '+result.status+').');location.assign('/events/EventTypeResponse/list');}catch(ex){error.textContent=ex.message;error.classList.remove('d-none');}})})();</script>
</div></Page>
@code{[Parameter,EditorRequired]public EventTypeEditModel Model {get;set;}=null!;[Parameter]public bool IsFragment {get;set;}}
