@namespace WebAppArchitecture.Events

<MediumCard TModel="EventTypeModel" Model="@Model" HeaderText="Typ události">
    <ChildContent Context="item">
        <Attribute TModel="EventTypeModel" Item="@item" Label="Název" AttributeName="Name" />
        <Attribute TModel="EventTypeModel" Item="@item" Label="Kód" AttributeName="Code" />
        <Attribute TModel="EventTypeModel" Item="@item" Label="Zkratka" AttributeName="Abbreviation" />
        <div class="mt-2"><a href="@($"/events/EventTypeResponse/edit/{item.id}")">Upravit typ</a></div>
    </ChildContent>
</MediumCard>

@code {
    [Parameter, EditorRequired] public EventTypeModel Model { get; set; } = default!;
}
