@namespace WebAppArchitecture.Events

<LargeCard TModel="EventTypeModel" Model="@Model" HeaderText="Typ události">
    <SideContent Context="item">
        <EventTypeMediumCard Model="@item" />
        <EntityPermissions RbacId="@item.rbacobject_id" App="events" />
    </SideContent>
    <ChildContent Context="item">
        <p>@item.Description</p>
        <Attribute TModel="EventTypeModel" Item="@item" Label="Registrace" AttributeName="RegistrationMode" />
        <Attribute TModel="EventTypeModel" Item="@item" Label="Nadřazený typ">
            @if (item.ParentId is Guid parentId)
            {
                <a href="@($"/events/EventTypeResponse/edit/{parentId}")">@parentId</a>
            }
            else
            {
                <span class="text-muted">žádný</span>
            }
        </Attribute>
    </ChildContent>
</LargeCard>

@code {
    [Parameter, EditorRequired] public EventTypeModel Model { get; set; } = default!;
}
