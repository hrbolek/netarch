@namespace WebAppArchitecture.Events
@using Microsoft.AspNetCore.Components
@using WebAppArchitecture.Base.UI.Components
<MediumCard TModel="EventModel" Model="@Model" HeaderText="@Model.Name">
 <ChildContent Context="item">
  <div class="small text-muted mb-2">@item.StartsAt.ToString("dd.MM.yyyy HH:mm") – @item.EndsAt.ToString("dd.MM.yyyy HH:mm")</div>
  <a href="@($"/events/EventResponse/detail/{item.id}")">Detail</a> · <a href="@($"/events/EventResponse/edit/{item.id}")">Editovat</a> · <a href="@($"/events/EventResponse/timetable/{item.id}")">Rozvrh</a>
 </ChildContent>
</MediumCard>
@code { [Parameter,EditorRequired] public EventModel Model {get;set;}=default!; }
