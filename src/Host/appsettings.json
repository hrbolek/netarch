{
  "DigitalProcesses": {
    "DataBackend": {
      "Provider": "GraphQL",
      "Endpoint": "http://serverjsonata:3000/graphql",
      "ForwardHeaders": [
        "cookie",
        "authorization",
        "accept-language",
        "x-request-id",
        "x-ms-client-principal",
        "x-ms-client-principal-id",
        "x-ms-client-principal-name"
      ]
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "WebAppArchitecture.DigitalProcesses": "Information",
      "DigitalProcesses.FormPreview.Import": "Trace",
      "WebAppArchitecture.DigitalProcesses.Services.GraphqlLikeFormDataBackend": "Trace"
    }
  }
}
