@using Microsoft.AspNetCore.Components

@namespace WebAppArchitecture.Base.UI.Components
@typeparam TItem
@typeparam TItemComponent where TItemComponent : IComponent

<div class="card">
    <div class="card-header">@Title</div>
    <div class="card-body d-grid gap-3">
        @if (Items.Count == 0)
        {
            <div class="text-muted">No related items.</div>
        }
        else
        {
            @foreach (var item in Items)
            {
                <DynamicComponent Type="@typeof(TItemComponent)" Parameters="@CreateParameters(item)" />
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyCollection<TItem> Items { get; set; } = Array.Empty<TItem>();
    [Parameter] public string Title { get; set; } = "Relations";

    private static IDictionary<string, object?> CreateParameters(TItem item)
        => new Dictionary<string, object?>
        {
            ["Model"] = item
        };
}
