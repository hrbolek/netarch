@namespace WebAppArchitecture.Base.UI.Pages
@typeparam TModel where TModel : IEntityDTOModel

<Page Title="@Title">
    <div class="container-fluid py-3">
        @if (Items is not null)
        {
            @foreach (var item in Items)
            {
                if (ChildContent is not null)
                {
                    @ChildContent(item)
                }
                else
                {
                    <WebAppArchitecture.Base.UI.Components.MediumCard TModel="TModel" Model="@item" />
                }
            }
        }
    </div>
</Page>

@code {
    [Parameter] public string Title { get; set; } = "Seznam";
    [Parameter, EditorRequired] public IReadOnlyCollection<TModel> Items { get; set; } = Array.Empty<TModel>();
    [Parameter] public RenderFragment<TModel>? ChildContent { get; set; }
}
