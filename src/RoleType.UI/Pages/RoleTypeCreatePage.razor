@using WebAppArchitecture.Base.UI.Pages

@namespace WebAppArchitecture.RoleType.UI.Pages

<Page Title="Vytvorit typ role">
    <div class="container py-3">
        <h1 class="h4 mb-3">Novy typ role</h1>
        <form method="post" action="/architecture/RoleTypeResponse/create-form" class="card card-body">
            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" name="name" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Operations (comma separated)</label>
                <input class="form-control" name="operations" placeholder="read,update,list" />
            </div>
            <button type="submit" class="btn btn-primary">Vytvorit</button>
        </form>
    </div>
</Page>
