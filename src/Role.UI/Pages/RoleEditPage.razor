@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Role.Models
@using WebAppArchitecture.Role.UI.Components

@namespace WebAppArchitecture.Role.UI.Pages

<PageEdit TModel="RoleResponse" Model="@Model" Title="Editace: Role">
    <ChildContent Context="item">
        <RoleLargeCard Model="@item">
            <ChildContent Context="largeItem">
                <RoleEditableCard Model="@largeItem" />
            </ChildContent>
        </RoleLargeCard>
    </ChildContent>
</PageEdit>

@code {
    [Parameter, EditorRequired]
    public RoleResponse Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
