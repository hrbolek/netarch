@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.Role.Models
@using WebAppArchitecture.Role.UI.Components

@namespace WebAppArchitecture.Role.UI.Pages

<PageViewList TModel="RoleResponse" Items="@Model" Title="Role">
    <ChildContent Context="item">
        <RoleMediumCard Model="@item" />
    </ChildContent>
</PageViewList>

@code {
    [Parameter, EditorRequired]
    public RoleResponse[] Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
