@using WebAppArchitecture.Base.UI.Components
@using WebAppArchitecture.Role.Models

@namespace WebAppArchitecture.Role.UI.Components

<EditableCard TModel="RoleResponse" Model="@Model" HeaderText="Role">
    <ChildContent Context="item">
        <form>
            <div class="mb-3">
                <label class="form-label">Role Type</label>
                <input class="form-control" name="role_type" value="@item.role_type" />
            </div>
            <div class="mb-3">
                <label class="form-label">Deputy</label>
                <input class="form-control" name="is_deputy" value="@item.is_deputy" />
            </div>
        </form>
    </ChildContent>
</EditableCard>

@code {
    [Parameter, EditorRequired]
    public RoleResponse Model { get; set; } = default!;
}
