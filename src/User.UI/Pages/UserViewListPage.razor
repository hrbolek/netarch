@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.User.UI.Components
@using WebAppArchitecture.User.Models

@namespace WebAppArchitecture.User.UI.Pages

<PageViewList
    TModel="UserResponse"
    Items="@Model"
    Title="Uživatel">
    <ChildContent Context="item">
        <UserMediumCard Model="@item" />
    </ChildContent>
</PageViewList>    

@code {
    [Parameter, EditorRequired]
    public UserResponse[] Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}