@using WebAppArchitecture.Base.UI.Pages
@using WebAppArchitecture.User.Models
@using WebAppArchitecture.User.UI.Components

@namespace WebAppArchitecture.User.UI.Pages

<PageEdit TModel="UserResponse" Model="@Model" Title="Editace: Uživatel">
    <ChildContent Context="item">
        <UserLargeCard Model="@item">
            <ChildContent Context="largeItem">
                <UserEditableCard Model="@largeItem" />
            </ChildContent>
        </UserLargeCard>
    </ChildContent>
</PageEdit>

@code {
    [Parameter, EditorRequired]
    public UserResponse Model { get; set; } = default!;

    [Parameter]
    public bool IsFragment { get; set; }
}
