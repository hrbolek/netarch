@namespace WebAppArchitecture.User.UI.Components
@using WebAppArchitecture.User.Models
@using WebAppArchitecture.Base.UI.Components

<div id="user-edit-root-@Model.id">
    <form hx-post="@($"/architecture/UserResponse/update/{Model.id}")"
          hx-target="@($"#user-edit-root-{Model.id}")"
          hx-swap="outerHTML">
        <div class="mb-3">
            <label class="form-label">Name</label>
            <input class="form-control"
                   name="Name"
                   value="@Model.Name"
                   hx-post="@($"/architecture/UserResponse/update/{Model.id}")"
                   hx-trigger="keyup changed delay:600ms"
                   hx-include="closest form"
                   hx-target="@($"#user-edit-root-{Model.id}")"
                   hx-swap="outerHTML" />
        </div>
        <button class="btn btn-primary" type="submit">Uložit</button>
    </form>
</div>

@code {
    [Parameter, EditorRequired]
    public UserResponse Model { get; set; } = default!;
}
