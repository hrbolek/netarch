@using WebAppArchitecture.User.Models
@using WebAppArchitecture.Base.UI.Components

@namespace WebAppArchitecture.User.UI.Components

<LargeCard
    TModel="UserResponse"
    Model="@Model"
    HeaderText="Uživatel">

    <SideContent Context="item">
        <UserMediumCard
            Model="@item" />
        <EntityLinks TModel="UserResponse" Model="@item" Links="@GetLinks(item)" />
    </SideContent>

    <ChildContent Context="item">
        @if (ChildContent is not null)
        {
            @ChildContent(item)
        }
    </ChildContent>

</LargeCard>

@code {
    [Parameter, EditorRequired]
    public UserResponse Model { get; set; } = default!;

    [Parameter]
    public RenderFragment<UserResponse>? ChildContent { get; set; }

    private static EntityNavigationLink[] GetLinks(UserResponse item)
        =>
        [
            new("Memberships", $"/architecture/UserResponse/{item.id}/memberships", "Memberships of this user"),
            new("Roles", $"/architecture/UserResponse/{item.id}/roles", "Roles of this user")
        ];
}